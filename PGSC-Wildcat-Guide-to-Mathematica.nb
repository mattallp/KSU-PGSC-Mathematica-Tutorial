Cell[BoxData[
 RowBox[{
  RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Clear", " ", "all", " ", "variables"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Your", " ", "code", " ", "here"}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.9769703275681095`*^9, 3.9769705158493385`*^9}, {
  3.976970645160671*^9, 3.976970742818342*^9}, {3.9769709209860477`*^9, 
  3.9769710199212456`*^9}, {3.9769710597342243`*^9, 
  3.9769711191954*^9}},ExpressionUUID->"bafe1215-536f-ab4e-a006-97533eba1024"]
}, Closed]],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",
 CellChangeTimes->{{3.9769710228876305`*^9, 
  3.9769710239671936`*^9}},ExpressionUUID->"d8ea7d50-5472-8047-b946-\
afa5b3fe007c"],

Cell["\<\
I can define the function using the pre-built Mathematica functions for the \
Bessel functions\
\>", "Text",
 CellChangeTimes->{{3.9769710286825657`*^9, 3.9769710496889496`*^9}, {
  3.976971125860815*^9, 
  3.9769711293880024`*^9}},ExpressionUUID->"804b1edf-869f-4246-b0b5-\
caea2047acd8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Clear", " ", "all", " ", "definitions"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], " ", "=", " ", 
   RowBox[{
    RowBox[{"BesselJ", "[", 
     RowBox[{"0", ",", "x"}], "]"}], "-", " ", 
    RowBox[{"BesselY", "[", 
     RowBox[{"0", ",", "x"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9769710228876305`*^9, 3.976971161954649*^9}, {
  3.9769712601524277`*^9, 3.9769712605005474`*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"156aa3d5-30b5-1048-afaf-6de4402fe6a0"],

Cell[TextData[{
 "There are a couple of ways I can find the first zero, if I use the FindRoot \
command, I need to specify where I want the to look by defining ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|"boxes" -> FormBox[
        SubscriptBox[
         StyleBox["x", "TI"], "0"], TraditionalForm], "errors" -> {}, "input" -> 
      "x_0", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], "."}], TraditionalForm]],ExpressionUUID->
  "a865c44d-d75c-4f40-9bcb-1216969d8f6f"],
 " Since I know that the function is singular at ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "\[LongEqual]", "0"}], TraditionalForm], 
     "errors" -> {}, "input" -> "x=0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c637d44b-7d49-6948-97ab-db8e319f1f32"],
 ", I will chose ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], "\[LongEqual]", "0.1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "x=0.1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "cd4c5b70-3950-b040-aac7-0aa190560792"],
 " "
}], "Text",
 CellChangeTimes->{{3.9769711666026955`*^9, 3.9769711899008923`*^9}, {
  3.9769712696529274`*^9, 
  3.9769713543242683`*^9}},ExpressionUUID->"7165b2d5-4d99-4940-ac31-\
0f41abb230be"],

Cell[BoxData[
 RowBox[{"FindRoot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], "==", "0"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0.01"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9769711666026955`*^9, 3.976971201232458*^9}, {
  3.9769712481400967`*^9, 3.9769712551563854`*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"758a6d89-1f33-6b4b-880e-a84fa2d14890"],

Cell["", "Text",
 CellChangeTimes->{{3.9769714493114185`*^9, 3.9769714725489063`*^9}, {
  3.9772463251897945`*^9, 
  3.977246329074583*^9}},ExpressionUUID->"7ded00d5-5d5f-664c-a545-\
4aff6db344c4"],

Cell["", "Text",
 CellChangeTimes->{{3.9769714493114185`*^9, 
  3.9769714731468945`*^9}},ExpressionUUID->"f4c14dda-29a3-fc49-9f66-\
969b2415ec1f"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Replace", "Subsection",
 CellChangeTimes->{{3.976971517887455*^9, 3.976971547142874*^9}, {
  3.9772468851690273`*^9, 3.9772469101449623`*^9}, {3.977501455301296*^9, 
  3.9775014556323357`*^9}},ExpressionUUID->"583eb70b-17dc-ea4e-b2fe-\
2f98318b4045"],

Cell[TextData[{
 "Now, we are going to introduce a couple of different ways Mathematica \
processes functions. We\[CloseCurlyQuote]ll mainly be focusing on some \
nuances of the syntax for a few different commands and explaining how \
Mathematica interprets them. Unfortunately, you will most likely have to \
learn through experience when to use the techniques presented here. \n\nThe \
first command we want to introduce is the",
 StyleBox[" Replace",
  FontWeight->"Bold"],
 " command, denoted using slash-dot (/.). The replace command can replace \
symbols or placeholders with actual values. This can be useful if you want to \
have the symbolic expression readily available but still want to get numbers \
for specific parameters.  \n\nIn order to use the ",
 StyleBox["Replace ",
  FontWeight->"Bold"],
 "command, we also need what is called a rule. Rules take the form, \
<parameter> ->  <value>. The -> (dash-greater-than) symbol should turn into \
an arrow in Mathematica\[CloseCurlyQuote]s input cell.  A simple example is \
like below"
}], "Text",
 CellChangeTimes->{{3.976971517887455*^9, 3.9769715485208187`*^9}, {
   3.977246450772932*^9, 3.9772464720028763`*^9}, {3.977246506341463*^9, 
   3.9772465256877575`*^9}, {3.9772465826819305`*^9, 
   3.9772465923542633`*^9}, {3.9772467009793205`*^9, 
   3.9772467306122875`*^9}, {3.9772469127315025`*^9, 3.977246913995699*^9}, {
   3.977248711276884*^9, 3.977248712647888*^9}, {3.977499002884161*^9, 
   3.9774990612660713`*^9}, {3.977499157212118*^9, 3.9774992336241016`*^9}, {
   3.977499282336191*^9, 3.9774993933641186`*^9}, {3.977499579120455*^9, 
   3.977499669025341*^9}, {3.977499733389925*^9, 3.977499762194748*^9}, {
   3.9774998636875153`*^9, 3.9774998780355167`*^9}, 3.9774999284575176`*^9, {
   3.977499978770628*^9, 3.977500198657345*^9}, {3.977500241249569*^9, 
   3.9775003362474537`*^9}, {3.9775007740549164`*^9, 3.977500782999609*^9}, {
   3.9775009026255093`*^9, 3.977500956398012*^9}, {3.977502151214609*^9, 
   3.9775021715026836`*^9}},ExpressionUUID->"e146f4d7-5012-ce49-b6c9-\
712fdf85b683"],

Cell[BoxData[
 RowBox[{"a", " ", "/.", " ", 
  RowBox[{"a", "->", " ", "2"}]}]], "Input",
 CellChangeTimes->{{3.976971517887455*^9, 3.9769715485208187`*^9}, {
   3.977246450772932*^9, 3.9772464720028763`*^9}, {3.977246506341463*^9, 
   3.9772465256877575`*^9}, {3.9772465826819305`*^9, 
   3.9772465923542633`*^9}, {3.9772467009793205`*^9, 
   3.9772467306122875`*^9}, {3.9772469127315025`*^9, 3.977246913995699*^9}, {
   3.977248711276884*^9, 3.977248712647888*^9}, {3.977499002884161*^9, 
   3.9774990612660713`*^9}, {3.977499157212118*^9, 3.9774992336241016`*^9}, {
   3.977499282336191*^9, 3.9774993933641186`*^9}, {3.977499579120455*^9, 
   3.977499669025341*^9}, {3.977499733389925*^9, 3.977499762194748*^9}, {
   3.9774998636875153`*^9, 3.9774998780355167`*^9}, 3.9774999284575176`*^9, {
   3.977499978770628*^9, 3.977500198657345*^9}, {3.977500241249569*^9, 
   3.9775003362474537`*^9}, {3.9775007740549164`*^9, 
   3.9775007961279144`*^9}, {3.9775009580495815`*^9, 3.977500962457617*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"df10244b-e109-7f4c-befc-1a9d43b8b610"],

Cell["\<\
Mathematica outputs the number 2 since I told Mathematica to replace a with \
2.  You can also do this with expressions and multiple parameters:\
\>", "Text",
 CellChangeTimes->{{3.976971517887455*^9, 3.9769715485208187`*^9}, {
   3.977246450772932*^9, 3.9772464720028763`*^9}, {3.977246506341463*^9, 
   3.9772465256877575`*^9}, {3.9772465826819305`*^9, 
   3.9772465923542633`*^9}, {3.9772467009793205`*^9, 
   3.9772467306122875`*^9}, {3.9772469127315025`*^9, 3.977246913995699*^9}, {
   3.977248711276884*^9, 3.977248712647888*^9}, {3.977499002884161*^9, 
   3.9774990612660713`*^9}, {3.977499157212118*^9, 3.9774992336241016`*^9}, {
   3.977499282336191*^9, 3.9774993933641186`*^9}, {3.977499579120455*^9, 
   3.977499669025341*^9}, {3.977499733389925*^9, 3.977499762194748*^9}, {
   3.9774998636875153`*^9, 3.9774998780355167`*^9}, 3.9774999284575176`*^9, {
   3.977499978770628*^9, 3.977500198657345*^9}, {3.977500241249569*^9, 
   3.9775003362474537`*^9}, {3.9775007740549164`*^9, 
   3.9775007933427944`*^9}, {3.9775009255265503`*^9, 3.977501006838625*^9}, {
   3.9775010977603283`*^9, 3.977501102930155*^9}, {3.9775011543979645`*^9, 
   3.9775011655115128`*^9}},ExpressionUUID->"7f6af919-3c94-4b4d-a017-\
86dd31cce78d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"a", " ", "+", " ", "b"}], " ", "/.", " ", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"a", "->", " ", "1"}], ",", " ", 
    RowBox[{"b", "->", " ", "2"}], ",", 
    RowBox[{"c", " ", "->", " ", "10"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.976971517887455*^9, 3.9769715485208187`*^9}, {
   3.977246450772932*^9, 3.9772464720028763`*^9}, {3.977246506341463*^9, 
   3.9772465256877575`*^9}, {3.9772465826819305`*^9, 
   3.9772465923542633`*^9}, {3.9772467009793205`*^9, 
   3.9772467306122875`*^9}, {3.9772469127315025`*^9, 3.977246913995699*^9}, {
   3.977248711276884*^9, 3.977248712647888*^9}, {3.977499002884161*^9, 
   3.9774990612660713`*^9}, {3.977499157212118*^9, 3.9774992336241016`*^9}, {
   3.977499282336191*^9, 3.9774993933641186`*^9}, {3.977499579120455*^9, 
   3.977499669025341*^9}, {3.977499733389925*^9, 3.977499762194748*^9}, {
   3.9774998636875153`*^9, 3.9774998780355167`*^9}, 3.9774999284575176`*^9, {
   3.977499978770628*^9, 3.977500198657345*^9}, {3.977500241249569*^9, 
   3.9775003362474537`*^9}, {3.9775007740549164`*^9, 
   3.9775007933427944`*^9}, {3.9775009255265503`*^9, 3.977501006838625*^9}, {
   3.9775010977603283`*^9, 3.977501102930155*^9}, {3.9775011543979645`*^9, 
   3.977501177013338*^9}, {3.9775012142556725`*^9, 3.9775012201510124`*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"35eb96e9-9785-3546-a649-9f1fcf5306fb"],

Cell["\<\
Note that Mathematica will still evaluate the expression even if your rule \
contains parameters which don\[CloseCurlyQuote]t appear in the expression. \
\>", "Text",
 CellChangeTimes->{{3.977501181897558*^9, 
  3.9775012120599365`*^9}},ExpressionUUID->"cba7e896-f8fd-974b-87df-\
5ac0dc5a0190"],

Cell[TextData[{
 "For a more applicable example, suppose I am working with the magnitude of \
some electric field . I can store the constants I might use in a rule and use \
",
 StyleBox["Replace",
  FontWeight->"Bold"],
 " to numerically evaluate the field :"
}], "Text",
 CellChangeTimes->{{3.976971517887455*^9, 3.9769715485208187`*^9}, {
   3.977246450772932*^9, 3.9772464720028763`*^9}, {3.977246506341463*^9, 
   3.9772465256877575`*^9}, {3.9772465826819305`*^9, 
   3.9772465923542633`*^9}, {3.9772467009793205`*^9, 
   3.9772467306122875`*^9}, {3.9772469127315025`*^9, 3.977246913995699*^9}, {
   3.977248711276884*^9, 3.977248712647888*^9}, {3.977499002884161*^9, 
   3.9774990612660713`*^9}, {3.977499157212118*^9, 3.9774992336241016`*^9}, {
   3.977499282336191*^9, 3.9774993933641186`*^9}, {3.977499579120455*^9, 
   3.977499669025341*^9}, {3.977499733389925*^9, 3.977499762194748*^9}, {
   3.9774998636875153`*^9, 3.9774998780355167`*^9}, 3.9774999284575176`*^9, {
   3.977499978770628*^9, 3.977500198657345*^9}, {3.977500241249569*^9, 
   3.9775003362474537`*^9}, {3.9775007740549164`*^9, 
   3.9775007933427944`*^9}, {3.9775009255265503`*^9, 
   3.9775009418910103`*^9}},ExpressionUUID->"61356ab5-f3c7-184c-afff-\
9b6eb20ae328"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MagEField", "[", "r_", "]"}], " ", "=", "  ", 
   RowBox[{"k", " ", 
    FractionBox["q", 
     SuperscriptBox["r", "2"]]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "magnitude", " ", "of", " ", "the", " ", 
    "electric", " ", "field"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"EMrule", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"k", " ", "->", " ", 
       RowBox[{"8.99", " ", "*", 
        SuperscriptBox["10", "9"]}]}], " ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Coulomb", "'"}], "s", " ", "constant", " ", "in", " ", "N", " ", 
        RowBox[{
         RowBox[{"m", "^", "2"}], "/", 
         RowBox[{"C", "^", "2"}]}]}], "*)"}], ",", " ", 
      RowBox[{"q", " ", "->", " ", 
       RowBox[{"1.60218", "*", " ", 
        SuperscriptBox["10", 
         RowBox[{"-", "19"}]]}]}]}], " ", 
     RowBox[{"(*", 
      RowBox[{"elementary", " ", "charge", " ", "in", " ", "Coulombs"}], 
      "*)"}], "}"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "create", " ", "a", " ", "list", " ", "of", " ", "replacement", " ", 
    "rules", " ", "for", " ", "the", " ", "constants"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MagEField", "[", "0.1", "]"}], "/.", " ", "EMrule", " ", 
  RowBox[{"(*", 
   RowBox[{
   "calculate", " ", "the", " ", "magnitude", " ", "of", " ", "the", " ", 
    "magnetic", " ", "field", " ", "at", " ", "0.1", "m", " ", "with", " ", 
    "above", " ", "constants"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.976971517887455*^9, 3.9769715485208187`*^9}, {
   3.977246450772932*^9, 3.9772464720028763`*^9}, {3.977246506341463*^9, 
   3.9772465256877575`*^9}, {3.9772465826819305`*^9, 
   3.9772465923542633`*^9}, {3.9772467009793205`*^9, 
   3.9772467306122875`*^9}, {3.9772469127315025`*^9, 3.977246913995699*^9}, {
   3.977248711276884*^9, 3.977248712647888*^9}, {3.977499002884161*^9, 
   3.9774990612660713`*^9}, {3.977499157212118*^9, 3.9774992336241016`*^9}, {
   3.977499282336191*^9, 3.9774993933641186`*^9}, {3.977499579120455*^9, 
   3.977499669025341*^9}, {3.977499733389925*^9, 3.977499762194748*^9}, {
   3.9774998636875153`*^9, 3.9774998780355167`*^9}, 3.9774999284575176`*^9, {
   3.977499978770628*^9, 3.9775001745150604`*^9}, {3.9775002361394005`*^9, 
   3.9775002364979343`*^9}, {3.977500289484129*^9, 3.9775003032953663`*^9}, {
   3.9775003402407913`*^9, 3.9775004124782066`*^9}, {3.977500444837631*^9, 
   3.977500497114916*^9}, {3.977500576656889*^9, 3.9775006452013626`*^9}, {
   3.9775006975095367`*^9, 3.9775007666322517`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"60b2fac5-2ff4-9440-b62d-04b0f6c9d0de"],

Cell["\<\
The replace command is also useful because a lot of pre-built Mathematica \
functions return rules as output. A previous exercise asked you to find the \
zero of a function, below I have copied the solution \
\>", "Text",
 CellChangeTimes->{{3.97750144813628*^9, 
  3.9775015938621674`*^9}},ExpressionUUID->"9d140e11-123b-b54a-ab92-\
e33db59bb950"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Clear", " ", "variables"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{"BesselJ", "[", 
      RowBox[{"0", ",", "x"}], "]"}], "-", " ", 
     RowBox[{"BesselY", "[", 
      RowBox[{"0", ",", "x"}], "]"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Define", " ", "function"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"FindRoot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], "==", "0"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0.01"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Find", " ", "the", " ", "first", " ", "order", " ", "zero"}], 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{3.97750144813628*^9, 3.977501643576782*^9}},
 CellLabel->"In[19]:=",ExpressionUUID->"a970316b-d87f-054c-a29b-88d01ff82e9c"],

Cell["\<\
Notice Mathematica returned a rule as the output. We can use the replace \
command to access this value for a function. We can check to make sure this \
is actually a zero of the function, or evaluate the derivative:\
\>", "Text",
 CellChangeTimes->{{3.9775016530513077`*^9, 3.9775016658254547`*^9}, {
  3.977501705144327*^9, 3.977501724112566*^9}, {3.9775019195970936`*^9, 
  3.9775019806330376`*^9}},ExpressionUUID->"4c47e023-63c4-3e41-818e-\
02eaced00058"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], "/.", " ", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], "==", "0"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0.01"}], "}"}]}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Check", " ", "to", " ", "make", " ", "sure", " ", "this", " ", "is", " ", 
    "actually", " ", "a", " ", "zero"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "'"}], "[", "x", "]"}], "/.", " ", 
  RowBox[{"FindRoot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], "==", "0"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0.01"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Calculate", " ", "the", " ", "derivative", " ", "at", " ", "the", " ", 
    "zero"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9775016530513077`*^9, 3.9775016658254547`*^9}, {
  3.977501705144327*^9, 3.977501724112566*^9}, {3.9775019195970936`*^9, 
  3.9775020134278374`*^9}, {3.977502115951721*^9, 3.977502122019497*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"64b096aa-23b2-0044-8e78-e05aaa86d7d9"]
}, Closed]],

Cell[CellGroupData[{

Cell["Prefix and Postfix", "Subsection",
 CellChangeTimes->{{3.977501463759281*^9, 
  3.977501467544937*^9}},ExpressionUUID->"ccee3404-fda7-8e4c-b34d-\
7ab758fd8048"],

Cell["We can also evaluate functions using prefix notation (@). ", "Text",
 CellChangeTimes->{{3.977501253556959*^9, 3.9775013849455357`*^9}, {
  3.977502191117384*^9, 3.9775022021061134`*^9}, {3.977502267057829*^9, 
  3.977502276237734*^9}, {3.9775024008281307`*^9, 
  3.9775024094834213`*^9}},ExpressionUUID->"8d67cf4e-4bbb-2b41-bbbd-\
ab2f48ebb479"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "f", "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Clear", " ", "the", " ", "function", " ", "f"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", " ", 
   RowBox[{"x", "^", "3"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "function"}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"f", "@", "3", " ", 
  RowBox[{"(*", 
   RowBox[{"Evaluate", " ", "the", " ", "function", " ", "at", " ", "3"}], 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{3.977501253556959*^9, 3.9775013849455357`*^9}, {
  3.977502191117384*^9, 
  3.977502282241827*^9}},ExpressionUUID->"76c2a718-5a38-924b-bc8a-\
e1dfef6be9e6"],

Cell["\<\
The line \[OpenCurlyDoubleQuote]f@3\[CloseCurlyDoubleQuote] can be read as \
\[OpenCurlyDoubleQuote]the function, f ,evaluated at \
3\[CloseCurlyDoubleQuote].  This, of course, isn\[CloseCurlyQuote]t much \
different than just doing f[3]. However, when used in conjunction with \
\[OpenCurlyDoubleQuote]nameless\[CloseCurlyDoubleQuote], or pure, functions \
they can become much more useful. A nameless function is exactly what it \
sounds like, it is a function which was not previously defined and therefore \
doesn\[CloseCurlyQuote]t have a name. These functions use # to denote \
variables and & to denote where they end:\
\>", "Text",
 CellChangeTimes->{{3.977502285008751*^9, 3.9775023174789276`*^9}, {
  3.9775023747886333`*^9, 3.9775023819248543`*^9}, {3.977502414614393*^9, 
  3.9775025370820084`*^9}, {3.9775027435809727`*^9, 3.9775027479375095`*^9}, {
  3.977502788881592*^9, 3.9775027944553585`*^9}, {3.977502842440834*^9, 
  3.9775028897712536`*^9}},ExpressionUUID->"f7fb092c-165f-9044-8450-\
cde9f3fee91e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    SuperscriptBox["2", "#1"], "&"}], ")"}], "[", "x", "]"}], "\n", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{
      SuperscriptBox["#1", "2"], " ", 
      SuperscriptBox["#2", "2"]}], "+", "#3"}], "&"}], ")"}], "[", 
  RowBox[{"x", ",", "y", ",", "z"}], "]"}]}], "Input",
 CellChangeTimes->{{3.977502285008751*^9, 3.9775023174789276`*^9}, {
   3.9775023747886333`*^9, 3.9775023819248543`*^9}, {3.977502414614393*^9, 
   3.9775025370820084`*^9}, {3.9775027435809727`*^9, 
   3.9775027479375095`*^9}, {3.977502788881592*^9, 3.9775028806021805`*^9}, 
   3.9929447857118587`*^9},
 CellLabel->"In[34]:=",ExpressionUUID->"09a03610-cd43-7343-b446-d76f098a0982"],

Cell["\<\
Again, this may not be particularly useful on its own, but using the two can \
be very useful when you want to apply the same operation to a set of numbers\
\>", "Text",
 CellChangeTimes->{{3.977502900026346*^9, 3.9775029145479374`*^9}, {
  3.977503067055929*^9, 3.9775030812879868`*^9}, {3.9775031302832584`*^9, 
  3.977503149244528*^9}},ExpressionUUID->"450d12e3-3773-fa4c-bede-\
08f73863ea29"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     FractionBox[
      SuperscriptBox["#1", "2"], "9"], "+", "6"}], "&"}], ")"}], "[", 
  RowBox[{"{", 
   RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.977502900026346*^9, 3.9775029145479374`*^9}, {
   3.977503067055929*^9, 3.9775030812879868`*^9}, {3.9775031302832584`*^9, 
   3.977503179529873*^9}, 3.9929447857706223`*^9},
 CellLabel->"In[36]:=",ExpressionUUID->"203cd4f1-3836-dc44-9c7e-1a7ba6760b82"],

Cell["\<\
Another useful notation is postfix notation (//). This notation tells \
Mathematica to apply a command after evaluating everything else first. There \
are a few common instances where I use post fixing myself:

For numerical outputs:\
\>", "Text",
 CellChangeTimes->{{3.977502248850111*^9, 3.9775022509693184`*^9}, {
   3.977503344121319*^9, 3.977503356291477*^9}, {3.977503496642023*^9, 
   3.9775035417303467`*^9}, {3.977503582789076*^9, 3.9775036300697517`*^9}, 
   3.992944231550417*^9, {3.9929450372925777`*^9, 
   3.9929450467591267`*^9}},ExpressionUUID->"b92561f7-d00e-8842-a802-\
5e37613fc284"],

Cell[BoxData[{
 SqrtBox["10"], "\n", 
 RowBox[{"N", "[", 
  SqrtBox["10"], "]"}]}], "Input",
 CellChangeTimes->{{3.977502248850111*^9, 3.9775022509693184`*^9}, {
   3.977503344121319*^9, 3.977503356291477*^9}, {3.977503496642023*^9, 
   3.9775035417303467`*^9}, {3.977503582789076*^9, 3.9775036300697517`*^9}, {
   3.992944233991396*^9, 3.992944271005434*^9}, 3.992944785774626*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"96e9a6d1-c665-a443-b85a-b3c7a3d85c2b"],

Cell["Simplifying and expanding expressions:", "Text",
 CellChangeTimes->{{3.977502248850111*^9, 3.9775022509693184`*^9}, {
  3.977503344121319*^9, 3.977503356291477*^9}, {3.977503496642023*^9, 
  3.9775035417303467`*^9}, {3.977503582789076*^9, 3.9775036492704887`*^9}, {
  3.992944277346678*^9, 3.992944279356369*^9}, {3.992944515406687*^9, 
  3.992944516814991*^9}},ExpressionUUID->"8f502ae0-9906-d244-901c-\
16a7aecddf8f"],

Cell[BoxData[{
 RowBox[{"Simplify", "[", 
  RowBox[{
   SuperscriptBox["x", "2"], "+", 
   RowBox[{"2", " ", "x"}], "+", "1"}], "]"}], "\n", 
 RowBox[{"Expand", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"x", "+", "1"}], ")"}], " ", 
   RowBox[{"(", 
    RowBox[{"x", "+", "2"}], ")"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.977502248850111*^9, 3.9775022509693184`*^9}, {
   3.977503344121319*^9, 3.977503356291477*^9}, {3.977503496642023*^9, 
   3.9775035417303467`*^9}, {3.977503582789076*^9, 3.9775036492704887`*^9}, {
   3.992944277346678*^9, 3.9929442798673096`*^9}, {3.9929445206603775`*^9, 
   3.9929445944099064`*^9}, 3.992944785797922*^9},
 CellLabel->"In[5]:=",ExpressionUUID->"d9981ed0-e264-3b4d-870b-40949ae4a5cb"],

Cell["Matrix operations, including matrix form:", "Text",
 CellChangeTimes->{{3.977502248850111*^9, 3.9775022509693184`*^9}, {
  3.977503344121319*^9, 3.977503356291477*^9}, {3.977503496642023*^9, 
  3.9775035417303467`*^9}, {3.977503582789076*^9, 3.9775036433929577`*^9}, {
  3.9929447653094807`*^9, 3.9929447661984177`*^9}, {3.9929450701742363`*^9, 
  3.9929450924756184`*^9}},ExpressionUUID->"62fb22ec-50b4-9d4f-83d5-\
f4951f662743"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4"}], "}"}]}], "}"}]}], "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", " ", "//", " ", "MatrixForm"}], " ", 
  RowBox[{"(*", 
   RowBox[{"outputs", " ", "matrix", " ", "form"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"A", " ", "//", " ", "Transpose"}], " ", "//", " ", "MatrixForm"}],
   " ", 
  RowBox[{"(*", 
   RowBox[{
   "transposes", " ", "the", " ", "matrix", " ", "and", " ", "then", " ", 
    "outputs", " ", "matrix", " ", "form"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"A", " ", "//", " ", "Inverse"}], " ", "//", " ", "MatrixForm", " ", 
  RowBox[{"(*", 
   RowBox[{
   "inverts", " ", "the", " ", "matrix", " ", "and", " ", "outputs", " ", 
    "the", " ", "matrix", " ", "form"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.977502248850111*^9, 3.9775022509693184`*^9}, {
  3.977503344121319*^9, 3.977503356291477*^9}, {3.977503496642023*^9, 
  3.9775035417303467`*^9}, {3.977503582789076*^9, 3.9775036433929577`*^9}, {
  3.9929447653094807`*^9, 3.9929447926643925`*^9}, {3.9929449790357113`*^9, 
  3.9929449831014023`*^9}, {3.992945064150322*^9, 
  3.9929451660176563`*^9}},ExpressionUUID->"5e707774-e869-0744-80b8-\
936d586db6c0"],

Cell["\<\
Notice how we can apply multiple postfix commands, the commands are applied \
from left to right. Be careful, when using postfixing with definitions as it \
will store whatever the result of the postfix command is. For example, you \
may end up storing the Matrix form of an object:\
\>", "Text",
 CellChangeTimes->{{3.992945050908993*^9, 3.992945062667816*^9}, {
   3.992945168567911*^9, 3.99294519878298*^9}, {3.992946027698576*^9, 
   3.9929461107473316`*^9}, {3.9929461418690453`*^9, 3.9929461745108356`*^9}, 
   3.9929466999093647`*^9, 
   3.9929467611338425`*^9},ExpressionUUID->"9f362f82-da36-1542-93ee-\
bab979b40a18"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"A", " ", "=", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}]}], "}"}], " ", "//", " ", 
     "MatrixForm"}]}], " ", 
   RowBox[{"(*", 
    RowBox[{"stores", " ", "the", " ", "matrix", " ", "form"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"A", ".", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0"}], "}"}], " ", 
    RowBox[{"(*", 
     RowBox[{
      RowBox[{"won", "'"}], "t", " ", "do", " ", "the", " ", "calculation", " ",
       "because", " ", "A", " ", "is", " ", "not", " ", "a", " ", "list", " ",
       "but", " ", "the", " ", "matrix", " ", "form", " ", "of", " ", "a", " ",
       "list"}], "*)"}]}]}]}]], "Input",
 CellChangeTimes->{
  3.9929458592705383`*^9, {3.992946113388504*^9, 3.9929461373927937`*^9}, {
   3.9929467206116085`*^9, 3.992946754701462*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"8033409a-aa2d-6d44-9f42-fb7e14a4c939"],

Cell[CellGroupData[{

Cell["Exercise", "Subsubsection",
 CellChangeTimes->{{3.9929468041781654`*^9, 
  3.9929468061879444`*^9}},ExpressionUUID->"b8aba663-e172-2744-893c-\
74f067092191"],

Cell[TextData[{
 "In section V, we will be dealing with how to plot and fit data. It will be \
useful to know how to convert two related lists of data into a set of ordered \
pairs. For this exercise, you will hopefully be able to find a way to do so \
(or at least look at the solution for a way to do so).  Here you have two \
sets of data X = {",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["x", "TI"], "2"], ",", "\[Ellipsis]", ",", 
         SubscriptBox[
          StyleBox["x", "TI"], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "x_1,x_2,\\ldots,x_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "61784a34-de98-7e47-8977-62f7be68677c"],
 "}",
 StyleBox[" ", "Subsubsection"],
 "and Y = {",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["y", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["y", "TI"], "2"], ",", "\[Ellipsis]", ",", 
         SubscriptBox[
          StyleBox["y", "TI"], 
          StyleBox["n", "TI"]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "y_1,y_2,\\ldots,y_n", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "8866ef83-7aa3-be40-b48c-061040a610c0"],
 "}, convert the data into a list of ordered pairs, pairList = {(",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox[
          StyleBox["x", "TI"], "1"], ",", 
         SubscriptBox[
          StyleBox["y", "TI"], "1"], ")", ",", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], "2"], ",", 
             SubscriptBox[
              StyleBox["y", "TI"], "2"]}], ")"}], ",", "\[Ellipsis]", ",", 
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], 
              StyleBox["n", "TI"]], ",", 
             SubscriptBox[
              StyleBox["y", "TI"], 
              StyleBox["n", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "x_1,y_1),(x_2,y_2),\\ldots,(x_n,y_n)", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "1b9be4b3-1365-8747-847c-691dae931d86"],
 "}"
}], "Text",
 CellChangeTimes->{{3.9929468041781654`*^9, 3.9929468195769577`*^9}, {
  3.9929469533937283`*^9, 3.992947131525524*^9}, {3.992947163762535*^9, 
  3.9929471710319595`*^9}, {3.992947222849251*^9, 
  3.992947492417183*^9}},ExpressionUUID->"05aea140-a31e-7c4e-9f60-\
c3cd5860b91b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"X", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{"j", ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "20"}], "}"}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Data", " ", "set", " ", "X"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Y", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"RandomReal", "[", "]"}], ",", "20"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Data", " ", "set", " ", "Y"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"your", " ", "code", " ", "here"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9929468041781654`*^9, 3.9929468195769577`*^9}, {
  3.9929469533937283`*^9, 3.9929471570775566`*^9}, {3.992947242422264*^9, 
  3.9929472596191864`*^9}, {3.9929475147914314`*^9, 3.992947601998068*^9}, {
  3.992947784717535*^9, 
  3.9929477987435417`*^9}},ExpressionUUID->"faa2188f-6d15-8541-8958-\
0d3fdf7ef63b"]
}, Closed]],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",
 CellChangeTimes->{{3.9929477594186115`*^9, 
  3.9929477621242676`*^9}},ExpressionUUID->"8f71b1b3-37c2-2140-b1d5-\
476cce3411ca"],

Cell["\<\
Again, there are a lot of ways to do this, but I find that the simplest way \
is to simply place the two data sets in a list and then transpose them. \
\>", "Text",
 CellChangeTimes->{{3.992947772931267*^9, 
  3.9929478257023544`*^9}},ExpressionUUID->"21e6aef6-bfd9-144d-8658-\
c51fc98d03fe"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"X", ",", "Y"}], "}"}], "//", " ", "Transpose"}]], "Input",
 CellChangeTimes->{{3.9929477594186115`*^9, 3.992947768196308*^9}, {
  3.992947829432804*^9, 3.99294784602219*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"99c69861-9cd3-a641-a40b-a8c5d86f99cc"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Numerics and Integration", "Subsection",
 CellChangeTimes->{{3.9929479349014854`*^9, 3.9929479392459583`*^9}, {
  3.992947992167433*^9, 3.992947999457571*^9}, {3.993042107468937*^9, 
  3.9930421086727657`*^9}, {3.994156947550125*^9, 
  3.99415695274572*^9}},ExpressionUUID->"b8f17eb4-924b-274f-b7c3-\
77c8562bd874"],

Cell["\<\
As with all mathematical computing, we also need to be mindful of the quirks \
and nuances of numerical accuracy and precision. I will not go into the \
specifics of the different types of numerical errors that occur, for that you \
will have to take a course that deals with numerical methods. However, in \
Mathematica there are a few built-in tools that help us to manage numerics. \
We have already seen the use of the numerical evaluation command, N (see \
Section 1, Variables and Basic Functions):\
\>", "Text",
 CellChangeTimes->{{3.9929479349014854`*^9, 3.9929481910779495`*^9}, {
  3.9929482492609158`*^9, 3.9929482964550915`*^9}, {3.9929484152468357`*^9, 
  3.992948416227564*^9}, {3.99294851088715*^9, 
  3.9929485427209797`*^9}},ExpressionUUID->"f848cd05-e957-f04f-aef9-\
6de1e98c5e90"],

Cell[BoxData[{
 RowBox[{"Pi", "  ", 
  RowBox[{"(*", 
   RowBox[{
   "outputs", " ", "the", " ", "exact", " ", "expression", " ", "for", " ", 
    "\[Pi]"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"N", "[", "Pi", "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "gives", " ", "a", " ", "numerical", " ", "approximation", " ", "for", " ",
     "\[Pi]"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"N", "[", 
   RowBox[{"Pi", ",", "3"}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Specifically", " ", "gives", " ", "a", " ", "numerical", " ", 
    "approximation", " ", "for", " ", "\[Pi]", " ", "to", " ", "3", " ", 
    "digits"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9929479349014854`*^9, 3.9929481910779495`*^9}, {
  3.9929482492609158`*^9, 3.9929482964550915`*^9}, {3.9929484152468357`*^9, 
  3.9929484904269085`*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"4dd51f9b-7ca5-bb4a-b6c4-3def3ebe2db9"],

Cell["\<\
While this can be helpful to manage the final output of any calculation, it \
won' t affect how Mathematica manages numerical values during calculation . \
Fortunately, Mathematica does have built - in commands for common types of \
numerical calculation . In this section, we are going to specifically go over \
integration and how to tweak and refine numerical integration . However, keep \
in mind that a lot of the numerical tweaking options we will introduce can \
apply to other commands.\
\>", "Text",
 CellChangeTimes->{{3.992948546508007*^9, 3.9929485523373737`*^9}, {
  3.992948594973736*^9, 3.992948618538702*^9}, {3.9929487244035225`*^9, 
  3.9929487897723064`*^9}, {3.992948868525984*^9, 3.9929488911562195`*^9}, {
  3.992948925218214*^9, 3.9929489663234043`*^9}, {3.9929490060540657`*^9, 
  3.992949008473812*^9}, {3.9929491004075546`*^9, 3.992949110860607*^9}, {
  3.992949250178299*^9, 3.9929492769078884`*^9}, {3.992949328509081*^9, 
  3.9929493378705482`*^9}, {3.992949424501524*^9, 3.9929494648589554`*^9}, {
  3.994157073998904*^9, 3.994157176744123*^9}, {3.994157296284689*^9, 
  3.994157329637529*^9}, {3.9941575552393703`*^9, 3.994157563245831*^9}, {
  3.994158470510313*^9, 
  3.994158481435874*^9}},ExpressionUUID->"e6b42ef4-f00a-8748-bde3-\
091fb962395d"],

Cell[CellGroupData[{

Cell["Exact Integration", "Subsubsection",
 CellChangeTimes->{{3.994158542643426*^9, 
  3.994158545067492*^9}},ExpressionUUID->"53b7e372-8b1f-43b3-836a-\
667abd3df042"],

Cell[TextData[{
 "Before we go into the details of numerical integration, let\
\[CloseCurlyQuote]s first look at Mathematica\[CloseCurlyQuote]s capability \
to evaluate an Integral exactly. Mathematica\[CloseCurlyQuote]s ",
 StyleBox["Integral",
  FontWeight->"Bold"],
 " command will first attempt to evaluate an integral exactly:"
}], "Text",
 CellChangeTimes->{{3.992948546508007*^9, 3.9929485523373737`*^9}, {
   3.992948594973736*^9, 3.992948618538702*^9}, {3.9929487244035225`*^9, 
   3.9929487897723064`*^9}, {3.992948868525984*^9, 3.9929488911562195`*^9}, {
   3.992948925218214*^9, 3.9929489663234043`*^9}, {3.9929490060540657`*^9, 
   3.992949008473812*^9}, {3.9929491004075546`*^9, 3.992949110860607*^9}, {
   3.992949250178299*^9, 3.9929492769078884`*^9}, {3.992949328509081*^9, 
   3.9929493378705482`*^9}, {3.992949424501524*^9, 3.9929494648589554`*^9}, {
   3.994157073998904*^9, 3.994157176744123*^9}, {3.994157296284689*^9, 
   3.994157329637529*^9}, {3.9941575552393703`*^9, 3.994157613715835*^9}, 
   3.9941585328754377`*^9},ExpressionUUID->"83074847-2d01-48d8-9667-\
963630a5b922"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      SuperscriptBox["x", "2"]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "Infinity"}], ",", "Infinity"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Evaluates", " ", "the", " ", "Gaussian", " ", 
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          SubsuperscriptBox["\[Integral]", 
           RowBox[{"-", "\[Infinity]"}], "\[Infinity]"], 
          SuperscriptBox[
           StyleBox["e", "TI"], 
           RowBox[{"-", 
             SuperscriptBox[
              StyleBox["x", "TI"], "2"]}]], 
          StyleBox["d", "TI"], 
          StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
      "\\int_{-\\infty}^{\\infty} e^{-x^2}dx", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], " ", "exactly"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.992948546508007*^9, 3.9929485523373737`*^9}, {
  3.992948594973736*^9, 3.992948618538702*^9}, {3.9929487244035225`*^9, 
  3.9929487897723064`*^9}, {3.992948868525984*^9, 3.9929488911562195`*^9}, {
  3.992948925218214*^9, 3.9929489663234043`*^9}, {3.9929490060540657`*^9, 
  3.992949008473812*^9}, {3.9929491004075546`*^9, 3.992949110860607*^9}, {
  3.992949250178299*^9, 3.9929493176410236`*^9}, {3.994158060863953*^9, 
  3.994158060975902*^9}, {3.994158137696561*^9, 
  3.994158138154401*^9}},ExpressionUUID->"9550bea8-3192-aa47-b0c3-\
8390ae21f30a"],

Cell["\<\
It can also give expressions for antiderivatives, though it will omit the \
integration constant:\
\>", "Text",
 CellChangeTimes->{{3.994158835610888*^9, 3.9941588706663094`*^9}, {
  3.9941589086186037`*^9, 
  3.994158922881814*^9}},ExpressionUUID->"e4892044-c493-4523-ae9e-\
8049b1b01f19"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"2", "x"}], ",", "x"}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Integrates", " ", "2", "x", " ", "to", " ", "give", " ", "the", " ", 
    "antiderivative", " ", 
    SuperscriptBox["x", "2"]}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.994158835610888*^9, 3.9941588706663094`*^9}, {
  3.9941589086186037`*^9, 3.9941589968874617`*^9}},
 CellLabel->"In[48]:=",ExpressionUUID->"a05bf869-ee5a-403f-b211-1244ebe8ca7c"],

Cell["\<\
The Integration command can also handle multi-dimensional integrals:\
\>", "Text",
 CellChangeTimes->{{3.994159198593623*^9, 3.994159224925322*^9}, {
  3.994159310381764*^9, 3.994159357231235*^9}, {3.994159700369223*^9, 
  3.9941597115892267`*^9}, {3.994159777029749*^9, 3.9941597797740793`*^9}, {
  3.994161697001947*^9, 
  3.9941617226462297`*^9}},ExpressionUUID->"829c0730-ec24-49fb-adfd-\
e82947573f7e"],

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Exp", "[", "x", "]"}], 
    RowBox[{"Sin", "[", "y", "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "5"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "\[Pi]"}], ",", "0"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.994159198593623*^9, 3.994159224925322*^9}, {
  3.994159310381764*^9, 3.994159357231235*^9}, {3.994159700369223*^9, 
  3.9941597115892267`*^9}, {3.994159777029749*^9, 3.9941597797740793`*^9}, {
  3.994161697001947*^9, 
  3.994161711392861*^9}},ExpressionUUID->"1562cc60-64c6-4535-9bfb-\
b0c4ed820b42"],

Cell["\<\
It will even give multiple expressions or conditions depending on the values \
of undefined variables:\
\>", "Text",
 CellChangeTimes->{{3.994159198593623*^9, 3.994159224925322*^9}, {
  3.994159310381764*^9, 3.994159357231235*^9}, {3.994159700369223*^9, 
  3.9941597115892267`*^9}, {3.994159777029749*^9, 3.9941597797740793`*^9}, {
  3.994161697001947*^9, 
  3.994161702977714*^9}},ExpressionUUID->"f941a404-abd8-48e8-b8d2-\
99080528bcf3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"a", " ", 
      SuperscriptBox["x", "2"]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "Infinity"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Appropriately", " ", "determines", " ", "that", 
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          SubsuperscriptBox["\[Integral]", "0", "\[Infinity]"], 
          SuperscriptBox[
           StyleBox["e", "TI"], 
           RowBox[{
             StyleBox["a", "TI"], 
             SuperscriptBox[
              StyleBox["x", "TI"], "2"]}]], 
          StyleBox["d", "TI"], 
          StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
      "\\int_0^\\infty e^{ax^2}dx", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], " ", "only", " ", "converges", " ", "if", " ", 
    "Re", 
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          RowBox[{"(", 
            StyleBox["a", "TI"], ")"}], ">", "0"}], TraditionalForm], 
      "errors" -> {}, "input" -> "\\re(a) > 0", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"]}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.994159198593623*^9, 3.994159224925322*^9}, {
  3.994159310381764*^9, 3.9941593635036182`*^9}, {3.9941594534870462`*^9, 
  3.994159454555438*^9}, {3.994159662520569*^9, 3.994159691312841*^9}, {
  3.994159730570002*^9, 3.994159756670815*^9}, {3.9941600548405943`*^9, 
  3.994160107920904*^9}},ExpressionUUID->"7e45cd08-3a84-4893-a420-\
8670e79062e8"],

Cell[TextData[{
 "However, can get around this by using the ",
 StyleBox["Assumptions ",
  FontWeight->"Bold"],
 "option. This allows us to add conditions on the undefined variables to \
simplify the output. This is especially useful if you are wanting to use the \
expression later:"
}], "Text",
 CellChangeTimes->{{3.9941597832187777`*^9, 3.9941598303543158`*^9}, {
  3.994159956227499*^9, 
  3.994160005673059*^9}},ExpressionUUID->"f73eadee-dbbb-4c43-8b18-\
ba1558a2bfd0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ExpInt", "[", "a_", "]"}], "=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"a", " ", 
       SuperscriptBox["x", "2"]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "Infinity"}], "}"}], ",", 
     RowBox[{"Assumptions", " ", "->", " ", 
      RowBox[{"a", "<", "0"}]}]}], " ", "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "The", " ", "output", " ", "will", " ", "no", " ", "longer", " ", "have", 
     " ", "the", " ", "conditional"}], ",", " ", 
    RowBox[{
    "and", " ", "we", " ", "can", " ", "now", " ", "evaluate", " ", "the", " ",
      "integral", " ", "for", " ", "any", " ", "appropriate", " ", "value", " ",
      "of", " ", "a"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ExpInt", "[", 
   RowBox[{"-", "4"}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"evaluate", " ", "the", " ", "integral", " ", "with", " ", "a"}], 
    " ", "=", " ", 
    RowBox[{"-", "4"}]}], "*)"}], " "}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9941597832187777`*^9, 3.9941598303543158`*^9}, {
  3.994159956227499*^9, 3.994160053189666*^9}, {3.994160199241918*^9, 
  3.994160217949752*^9}, {3.994160255173974*^9, 3.994160260670394*^9}, {
  3.994160332486875*^9, 3.994160425659727*^9}, {3.9941604666360617`*^9, 
  3.994160504480322*^9}},ExpressionUUID->"9c1ac382-1927-42f8-921b-\
8188494a786d"],

Cell[TextData[{
 StyleBox["Assumptions",
  FontWeight->"Bold"],
 " can be added to a number of other commands, and you can even set global \
assumptions by using ",
 StyleBox["$Assumptions",
  FontWeight->"Bold"],
 ", however this is typically not recommended. You can also use the ",
 StyleBox["Assuming ",
  FontWeight->"Bold"],
 "command to execute a calculation with given assumptions:"
}], "Text",
 CellChangeTimes->{{3.99416044549934*^9, 3.99416046453553*^9}, {
   3.994160495728057*^9, 3.994160556784519*^9}, {3.994160701681903*^9, 
   3.994160762122511*^9}, 
   3.994161290678686*^9},ExpressionUUID->"a85f78aa-3e4d-4e2f-8670-\
23d93f5a7e9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Assuming", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"m", " ", "\[Element]", " ", "Integers"}], ",", " ", 
      RowBox[{"n", " ", "\[Element]", " ", "Integers"}]}], "}"}], ",", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"n", " ", "\[Pi]", " ", "x"}], "]"}], 
       RowBox[{"Sin", "[", 
        RowBox[{"m", " ", "\[Pi]", " ", "x"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", "0", ",", "2"}], "}"}]}], "]"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Orthogonality", " ", "of", " ", 
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"cos", "(", 
          RowBox[{
            StyleBox["n", "TI"], "\[Pi]", 
            StyleBox["x", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
      "input" -> "\\cos(n \\pi x)", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], "and", " ", 
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"sin", "(", 
          RowBox[{
            StyleBox["m", "TI"], "\[Pi]", 
            StyleBox["x", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
      "input" -> "\\sin (m \\pi x)", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"]}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.99416044549934*^9, 3.99416046453553*^9}, {
  3.994160495728057*^9, 3.994160556784519*^9}, {3.994160701681903*^9, 
  3.994160778250375*^9}, {3.994160970372347*^9, 3.994161098989676*^9}},
 CellLabel->"In[63]:=",ExpressionUUID->"1916684f-be7a-49f1-86cc-3c8f5f53da10"],

Cell["\<\
If you put in floating-point numbers for the domain of integration, \
Mathematica will evaluate the integral exactly, but then give a numerical \
approximation based on the numbers given:\
\>", "Text",
 CellChangeTimes->{{3.994162650319023*^9, 3.9941626837665787`*^9}, {
  3.99416273187857*^9, 3.994162806300372*^9}, {3.9941630505614643`*^9, 
  3.994163053993209*^9}},ExpressionUUID->"82030528-9e09-463f-93d7-\
c542670eaf36"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Integral]", "1", "2"], 
         StyleBox["x", "TI"], 
         StyleBox["d", "TI"], 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\int_1^2 x dx", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Integrate", "[", 
    RowBox[{"x", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1", ",", "2"}], "}"}]}], "]"}], " ", 
   RowBox[{"(*", "exact", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Integrate", "[", 
    RowBox[{"x", ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1.0", ",", "2.0"}], "}"}]}], "]"}], " ", 
   RowBox[{"(*", 
    RowBox[{"floating", " ", "point", " ", "decimal"}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.994162650319023*^9, 3.9941626837665787`*^9}, {
  3.99416273187857*^9, 3.9941628074961576`*^9}, {3.9941629038524942`*^9, 
  3.994162905632283*^9}, {3.994163061001645*^9, 3.994163093614142*^9}, {
  3.9941632135592747`*^9, 
  3.994163231563508*^9}},ExpressionUUID->"79b7b3a3-d365-4739-a458-\
5d2338d2407d"],

Cell["\<\
However, if Mathematica is unable to do an exact integration, it will just \
return the integral expression and we will have to turn to numerical \
techniques to evaluate the integral.\
\>", "Text",
 CellChangeTimes->{{3.994163125562766*^9, 
  3.994163167490094*^9}},ExpressionUUID->"9ab0573f-77ba-46c9-85fc-\
177c86bf8fd5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"Sin", "[", "x", "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0.4", ",", "1"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Mathematica", " ", "was", " ", "unable", " ", "to", " ", "evaluate", " ", 
    "the", " ", "integral", " ", "exactly", " ", "and", " ", "will", " ", 
    "just", " ", "return", " ", "the", " ", "integral", " ", "expression"}], 
   "*)"}]}]], "Input",
 CellChangeTimes->{{3.994162650319023*^9, 3.9941626837665787`*^9}, {
  3.99416273187857*^9, 3.994162803095916*^9}, {3.994162916196718*^9, 
  3.994162924868729*^9}},ExpressionUUID->"763d9d13-cfe8-4d39-aa15-\
9fafc6314a17"]
}, Closed]],

Cell[CellGroupData[{

Cell["Numerical Integration, Accuracy, and Precision", "Subsubsection",
 CellChangeTimes->{{3.992949438497555*^9, 3.992949446203745*^9}, {
  3.992949503310198*^9, 3.99294951697653*^9}, {3.992949620756092*^9, 
  3.9929496335188675`*^9}, {3.994157732269926*^9, 3.994157755888957*^9}, {
  3.994157811209362*^9, 3.994157824385651*^9}, {3.9941580181508904`*^9, 
  3.994158053287566*^9}, {3.994158465346918*^9, 3.99415846616249*^9}, {
  3.9941585563757353`*^9, 3.9941585784797373`*^9}, {3.9941638131679*^9, 
  3.9941638415361*^9}},ExpressionUUID->"f9bbfb53-5a67-f645-9aef-7efe6ea91500"],

Cell[TextData[{
 "This is the case for a number of Mathematica\[CloseCurlyQuote]s commands. \
However, if we know that an integral (or calculation) cannot be done exactly, \
we can utilize the ",
 StyleBox["NIntegrate ",
  FontWeight->"Bold"],
 "command. "
}], "Text",
 CellChangeTimes->{{3.9929479349014854`*^9, 3.9929481910779495`*^9}, {
  3.9929482492609158`*^9, 3.9929482934192924`*^9}, {3.9929497772048798`*^9, 
  3.9929498130963593`*^9}, {3.9929498665070915`*^9, 3.992949905292427*^9}, {
  3.9929499488048496`*^9, 3.992949969056402*^9}, {3.993029692947195*^9, 
  3.993029735858597*^9}, {3.99302978756312*^9, 3.9930298836913567`*^9}, {
  3.993029943289179*^9, 3.9930299677665195`*^9}, {3.993030028757126*^9, 
  3.993030030858675*^9}, {3.993030209050455*^9, 3.993030211050951*^9}, {
  3.993030278182234*^9, 3.993030315127407*^9}, {3.993030377435587*^9, 
  3.9930303939814873`*^9}, {3.993030440513525*^9, 3.9930304820463467`*^9}, {
  3.993030840182335*^9, 3.9930308569612293`*^9}, {3.993032292401287*^9, 
  3.993032300256838*^9}, {3.993041984128645*^9, 3.993041984578415*^9}, {
  3.9941631826145906`*^9, 3.994163202634507*^9}, {3.994163270596211*^9, 
  3.994163272742744*^9}},ExpressionUUID->"dc4738ad-7ed1-984f-949f-\
c4c233d4396f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"Sin", "[", "x", "]"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0.4", ",", "1"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Evaluate", " ", "the", " ", "integral", " ", "numerically"}], 
   "*)"}]}]], "Input",
 CellChangeTimes->{{3.9929479349014854`*^9, 3.9929481910779495`*^9}, {
  3.9929482492609158`*^9, 3.9929482934192924`*^9}, {3.9929497772048798`*^9, 
  3.9929498130963593`*^9}, {3.9929498665070915`*^9, 3.992949905292427*^9}, {
  3.9929499488048496`*^9, 3.992949969056402*^9}, {3.993029692947195*^9, 
  3.993029735858597*^9}, {3.99302978756312*^9, 3.9930298836913567`*^9}, {
  3.993029943289179*^9, 3.9930299677665195`*^9}, {3.993030028757126*^9, 
  3.993030030858675*^9}, {3.993030209050455*^9, 3.993030211050951*^9}, {
  3.993030278182234*^9, 3.993030315127407*^9}, {3.993030377435587*^9, 
  3.9930303939814873`*^9}, {3.993030440513525*^9, 3.9930304820463467`*^9}, {
  3.993030840182335*^9, 3.9930308569612293`*^9}, {3.993032292401287*^9, 
  3.993032300256838*^9}, {3.993041984128645*^9, 3.993041984578415*^9}, {
  3.9941631826145906`*^9, 3.994163202634507*^9}, {3.994163270596211*^9, 
  3.994163306735731*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"41aca11d-3be9-484d-a125-9d66fe243c8e"],

Cell[TextData[{
 "This command also has a lot of options that can change the method with \
which integration is done and change the precision and accuracy of the \
numbers used in calculation. Let\[CloseCurlyQuote]s look at an integral with \
some notable singularities: ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubsuperscriptBox["\[Integral]", "30", "\[Infinity]"], 
         FractionBox[
          SuperscriptBox[
           StyleBox["e", "TI"], 
           RowBox[{"-", 
             StyleBox["x", "TI"]}]], 
          RowBox[{"sin", "(", 
            RowBox[{"\[Pi]", 
              StyleBox["x", "TI"]}], ")"}]], 
         StyleBox["d", "TI"], 
         StyleBox["x", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\int_{30}^{\\infty} \\frac{e^{-x}}{\\sin(\\pi x)}dx", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "082b0295-c1d8-4b45-b8ad-bfc9ccb4370b"],
 "\nIf we try to use the normal ",
 StyleBox["Integrate ",
  FontWeight->"Bold"],
 "we see that it throws an error:"
}], "Text",
 CellChangeTimes->{{3.9929479349014854`*^9, 3.9929481910779495`*^9}, {
   3.9929482492609158`*^9, 3.9929482934192924`*^9}, {3.9929497772048798`*^9, 
   3.9929498130963593`*^9}, {3.9929498665070915`*^9, 3.992949905292427*^9}, {
   3.9929499488048496`*^9, 3.992949969056402*^9}, {3.993029692947195*^9, 
   3.993029735858597*^9}, {3.99302978756312*^9, 3.9930298836913567`*^9}, {
   3.993029943289179*^9, 3.9930299677665195`*^9}, {3.993030028757126*^9, 
   3.993030030858675*^9}, {3.993030209050455*^9, 3.993030211050951*^9}, {
   3.993030278182234*^9, 3.993030315127407*^9}, {3.993030377435587*^9, 
   3.9930303939814873`*^9}, {3.993030440513525*^9, 3.9930304820463467`*^9}, {
   3.993030840182335*^9, 3.9930308569612293`*^9}, {3.993032292401287*^9, 
   3.993032300256838*^9}, {3.993041984128645*^9, 3.993041984578415*^9}, {
   3.9941631826145906`*^9, 3.994163202634507*^9}, 3.994163270596211*^9, {
   3.994163316655757*^9, 
   3.994163318515727*^9}},ExpressionUUID->"f793e4fc-10a8-4451-91dd-\
c04863c9ab38"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Integrate", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"Exp", "[", 
      RowBox[{"-", "x"}], "]"}], 
     RowBox[{"Sin", "[", 
      RowBox[{"\[Pi]", " ", "x"}], "]"}]], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "30", ",", "Infinity"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "integration", " ", "of", " ", "a", " ", "singular", " ", "function", " ", 
    "will", " ", "give", " ", "a", " ", "error"}], "*)"}]}]], "Input",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGAQB2IQ/ePGndkf9791nFD3aDeIzonUOAyib2StPQGiE/rU
mj6BaNHFbSBawiqgF0RPiNacBKJDDs6cDqJ5zinOAtE5/vPaJQ+8dVxQ+bsH
RIuwFk0G0TPky+aD6C8OL5eB6JD2HytBdILVjI0g2qXqNpgOmat4AkSnLEwE
03euHL0AoncIp1wFy3/QvQuiIzLs74PoM3kCT8HiUyLfgugLu35/BNE9Mf/B
tM7KyyxSQHpJuQEriNaJfCYEog2CbEVAtE83+0owndS9HkQH1B05CaIZer+A
6RbVlddAdMK51BtgfSENd0D0FP11YNplxZlnILrje+MLEP2l7425PJCWWJxk
AaJdpv+7In4QKG8QfA1EAwBIjsjz
  "],
 CellLabel->"In[70]:=",ExpressionUUID->"76c01c04-189f-0c4f-9ed1-8b33169eadbf"],

Cell[TextData[{
 "If we use the NIntegrate command without any options, we still get errors \
and Mathematica again suggests that the integrand is probably zero. \
Mathematica will even output a number which is on the order of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "12"}]], TraditionalForm]],ExpressionUUID->
  "4351c66d-e857-9347-9869-6bcfbaf05fa0"],
 " (which is basically zero)"
}], "Text",
 CellChangeTimes->{{3.993030862884062*^9, 3.993030879332161*^9}, {
  3.9930312405704937`*^9, 3.9930313224695873`*^9}, {3.9930414117537537`*^9, 
  3.9930414551459713`*^9}},ExpressionUUID->"954a431c-d757-264b-91cd-\
87ea5b4c686c"],

Cell[BoxData[
 RowBox[{"NIntegrate", "[", 
  RowBox[{
   FractionBox[
    RowBox[{"Exp", "[", 
     RowBox[{"-", "x"}], "]"}], 
    RowBox[{"Sin", "[", 
     RowBox[{"\[Pi]", " ", "x"}], "]"}]], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "30", ",", "Infinity"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.993030862884062*^9, 3.993030879332161*^9}, {
   3.9930312405704937`*^9, 3.9930312553123207`*^9}, {3.9930318407721043`*^9, 
   3.9930318605884438`*^9}, {3.9930322500760174`*^9, 3.9930322507102222`*^9}, 
   3.9930324103712883`*^9, {3.993032521054323*^9, 3.9930325232560673`*^9}, {
   3.993037563725752*^9, 3.993037564448908*^9}, {3.9930412369130135`*^9, 
   3.9930412397492104`*^9}, {3.993041348858055*^9, 3.9930413493027306`*^9}},
 CellLabel->"In[65]:=",ExpressionUUID->"4943520f-5da9-dd41-bf15-046447336fd9"],

Cell[TextData[{
 "There are a few things we can do to get around these errors. We can tell \
Mathematica to handle the singularities using the ",
 StyleBox["Exclusions ",
  FontWeight->"Bold"],
 "option",
 ". It might also be helpful to increase the ",
 StyleBox["WorkingPrecision",
  FontWeight->"Bold"],
 " which tells Mathematica how many digits of precision to use during the \
numerical evaluation of the integral, and ",
 StyleBox["AccuracyGoal ",
  FontWeight->"Bold"],
 "which tells Mathematica how many digits of accuracy you want before \
Mathematica accepts the answer. In this case, setting the ",
 StyleBox["WorkingPrecision",
  FontWeight->"Bold"],
 " to 2 and ",
 StyleBox["AccuracyGoal ",
  FontWeight->"Bold"],
 "to 4 will make the integral return zero, which may be more useful than a \
small floating point number if we need to use it in later calculations. Feel \
free to mess with these values to see how it changes how Mathematica \
processes the integral."
}], "Text",
 CellChangeTimes->{{3.993031331601795*^9, 3.9930313908679047`*^9}, {
   3.993031421200657*^9, 3.9930314497134647`*^9}, {3.9930315068363304`*^9, 
   3.9930315567247353`*^9}, {3.993041399258724*^9, 3.993041404368431*^9}, {
   3.9930414623812065`*^9, 3.993041478165289*^9}, {3.9930415239768085`*^9, 
   3.9930416135192738`*^9}, {3.993041648390835*^9, 3.993041749982441*^9}, {
   3.993041931449892*^9, 3.9930419475792713`*^9}, 
   3.993042000657505*^9},ExpressionUUID->"09dc16df-1090-7e41-8982-\
84575274b760"],

Cell[BoxData[
 RowBox[{"NIntegrate", "[", 
  RowBox[{
   FractionBox[
    RowBox[{"Exp", "[", 
     RowBox[{"-", "x"}], "]"}], 
    RowBox[{"Sin", "[", 
     RowBox[{"\[Pi]", " ", "x"}], "]"}]], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "30", ",", "Infinity"}], "}"}], ",", " ", 
   RowBox[{"Exclusions", "->", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"\[Pi]", " ", "x"}], "]"}], " ", "==", " ", "0"}], ")"}]}], ",", 
   RowBox[{"WorkingPrecision", "->", "2"}], ",", " ", 
   RowBox[{"AccuracyGoal", "->", "4"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.993031331601795*^9, 3.9930313908679047`*^9}, {
  3.993031421200657*^9, 3.9930314497134647`*^9}, {3.9930315068363304`*^9, 
  3.9930317068880444`*^9}, {3.9930317609255543`*^9, 3.993031765184309*^9}, {
  3.993031826202017*^9, 3.993031827401808*^9}, {3.9930319937926216`*^9, 
  3.9930319971128006`*^9}, {3.9930323247638874`*^9, 3.9930323327434597`*^9}, {
  3.9930324477705746`*^9, 3.993032455216427*^9}, {3.9930325433473473`*^9, 
  3.9930325454697514`*^9}, {3.993039879114374*^9, 3.9930399198354454`*^9}, {
  3.9930399514610634`*^9, 3.9930399874387684`*^9}, {3.9930412467544136`*^9, 
  3.993041317277302*^9}, {3.9930413635304375`*^9, 3.9930413640580864`*^9}, {
  3.993041485579338*^9, 3.993041516683918*^9}, {3.99304159015172*^9, 
  3.993041597501009*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"86eebc6a-8759-b746-a051-1fe91876d83e"],

Cell[TextData[{
 "Another thing to point out is how options work for some built-in \
Mathematica commands, the syntax is [OptionName] -> <OptionValue>. The Arrow \
in the middle is made by typing the dash \[OpenCurlyDoubleQuote]-\
\[CloseCurlyDoubleQuote] and than greater-than symbol \
\[OpenCurlyDoubleQuote]>\[CloseCurlyDoubleQuote] like with the replace \
command syntax. A lot of built-in commands have options with their own \
possible values and you will have to read the documentation for a specific \
command to know what appropriate values are for specific options, these will \
come up more in section III on Plotting and Graphics. The ",
 StyleBox["NIntegrate",
  FontWeight->"Bold"],
 " command also allows you to change what numerical method is used to \
evaluate the integral, though appropriate use of these methods will require \
some more thorough research. \n\nCommands similar to ",
 StyleBox["NIntegrate ",
  FontWeight->"Bold"],
 "include ",
 StyleBox["NSolve, NSum, NExpectation, ",
  FontWeight->"Bold"],
 "and more. However, you may find that purely numerical commands like ",
 StyleBox["FindRoot ",
  FontWeight->"Bold"],
 "more useful when trying to find specific solutions to transcendental \
equations. "
}], "Text",
 CellChangeTimes->{{3.9930417534843063`*^9, 3.9930419293840523`*^9}, {
   3.9930419983943157`*^9, 3.993042083021837*^9}, {3.993042210134762*^9, 
   3.9930423053644543`*^9}, {3.993042336802494*^9, 3.9930424462912464`*^9}, {
   3.9930424788102646`*^9, 3.993042491619747*^9}, {3.9930425263026295`*^9, 
   3.993042606015835*^9}, {3.9930426441514416`*^9, 3.993042673596161*^9}, 
   3.9941564945863857`*^9, {3.994156533574687*^9, 3.994156575690963*^9}, {
   3.99415751253832*^9, 3.99415751428712*^9}, {3.9941633632238913`*^9, 
   3.994163365487547*^9}},ExpressionUUID->"d8d8c905-c880-2240-8d15-\
66d2359a2c03"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "An", " ", "example", " ", "of", " ", "using", " ", "FindRoot", " ", "to", 
    " ", "solve", " ", "a", " ", "trancendental", " ", "equation", " ", 
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          SuperscriptBox[
           StyleBox["e", "TI"], 
           StyleBox["x", "TI"]], "\[LongEqual]", 
          StyleBox["x", "TI"], "+", "2"}], TraditionalForm], "errors" -> {}, 
      "input" -> "e^x = x+ 2", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "+", "2"}], ",", 
       RowBox[{"Exp", "[", "x", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "3"}], ",", "4"}], "}"}]}], "]"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "A", " ", "plot", " ", "to", " ", "visualize", " ", "where", " ", "the", " ",
      "solutions", " ", "are", " ", "we", " ", "will", " ", "go", " ", "over",
      " ", "plots", " ", "in", " ", "section", " ", "3"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Exp", "[", "x", "]"}], "==", 
      RowBox[{"x", "+", "2"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "1"}], "}"}]}], "]"}], " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "an", " ", "example", " ", "with", " ", "the", " ", "FindRoot", " ", 
      "to", " ", "find", " ", "the", " ", "solution", " ", "near", " ", "x"}],
      " ", "=", " ", "1"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.993039892469099*^9, 3.993039915860386*^9}, {
  3.9930422201467495`*^9, 3.9930422469946423`*^9}, {3.993042280302477*^9, 
  3.9930423124892693`*^9}, {3.993042613129221*^9, 3.993042618774969*^9}, {
  3.994156389266119*^9, 3.994156527370976*^9}, {3.994156578591443*^9, 
