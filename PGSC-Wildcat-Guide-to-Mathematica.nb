 CellChangeTimes->{{3.9943454465006227`*^9, 
  3.994345456871377*^9}},ExpressionUUID->"18105ca8-4622-4862-9ed7-\
c80b9c7e6016"]
}, Closed]]
}, Closed]]
}, Open  ]]
