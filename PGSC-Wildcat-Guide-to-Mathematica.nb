1fc8cde790b2"],

Cell[TextData[{
 "==, the is equal to operator. Compares two expressions and returns ",
 StyleBox["True",
  FontWeight->"Bold"],
 " if they are equivalent",
 StyleBox[" ",
  FontWeight->"Bold"],
 "and false otherwise"
}], "Text",
 CellChangeTimes->{{3.9942461385698624`*^9, 3.994246146343397*^9}, {
  3.994246704575884*^9, 3.994246728071911*^9}, {3.994246788024935*^9, 
  3.994246796192169*^9}},ExpressionUUID->"28e8f309-c940-9d41-bed9-\
ffe6db27c120"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"1", " ", "==", " ", "2"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"returns", " ", "false", " ", "because", " ", "1"}], " ", "!=", 
     " ", "2"}], ",", " ", 
    RowBox[{
     RowBox[{"note", " ", "you", " ", 
      RowBox[{"can", "'"}], "t", " ", "use", " ", "a", " ", "single"}], " ", "=",
      " ", 
     RowBox[{
     "since", " ", "this", " ", "will", " ", "try", " ", "to", " ", "assign", 
      " ", "a", " ", "variable"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"x", "+", "1"}], ")"}], "2"], " ", "==", " ", 
   RowBox[{
    SuperscriptBox["x", "2"], "+", 
    RowBox[{"2", "x"}], " ", "+", " ", "1"}]}], "  ", "//", " ", "Simplify", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"returns", " ", 
     RowBox[{"true", ".", " ", "also"}], " ", "works", " ", "for", " ", 
     "different", " ", "forms", " ", "of", " ", "expressions"}], ",", " ", 
    RowBox[{
    "though", " ", "you", " ", "may", " ", "need", " ", "to", " ", "use", " ", 
     StyleBox["Simplify",
      FontWeight->"Bold"]}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9942456176339436`*^9, 3.9942456230864887`*^9}, {
   3.9942457010767975`*^9, 3.9942457040445805`*^9}, {3.9942457515538425`*^9, 
   3.9942457568341618`*^9}, {3.994245814873949*^9, 3.9942458868415318`*^9}, {
   3.994246032785406*^9, 3.994246078189472*^9}, 3.994246134107069*^9, {
   3.994246381855671*^9, 3.9942464115899525`*^9}, {3.994246729742733*^9, 
   3.994246782142462*^9}},ExpressionUUID->"27aad4fd-4075-5c40-bace-\
3e7907f449ab"],

