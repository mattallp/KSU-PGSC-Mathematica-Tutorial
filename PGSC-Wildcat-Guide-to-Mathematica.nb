Cell["\<\
!, logical not operator. You can combine this with other logical operators to \
negate them. \
\>", "Text",
 CellChangeTimes->{{3.9942456176339436`*^9, 3.9942456230864887`*^9}, {
  3.9942457010767975`*^9, 3.9942457040445805`*^9}, {3.9942457515538425`*^9, 
  3.9942457568341618`*^9}, {3.994245814873949*^9, 3.994245912246603*^9}, {
  3.9942459725421944`*^9, 3.9942460097355576`*^9}, {3.994246294536957*^9, 
  3.9942463015753727`*^9}, {3.994246829245714*^9, 3.9942468445813103`*^9}, {
  3.994246993597622*^9, 
  3.9942469964205704`*^9}},ExpressionUUID->"e3786222-bf4b-3c43-9f41-\
7a088327246e"],

Cell[BoxData[
 RowBox[{"1", " ", "!=", " ", "2", " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"returns", " ", "true", " ", "because", " ", "1"}], "!=", "2"}], 
    ",", " ", 
    RowBox[{
     RowBox[{"typed", " ", "by", " ", 
      RowBox[{"writing", " ", "!"}], " ", "and", " ", "then"}], " ", "="}]}], 
   "*)"}]}]], "Input",
 CellChangeTimes->{{3.9942456176339436`*^9, 3.9942456230864887`*^9}, {
  3.9942457010767975`*^9, 3.9942457040445805`*^9}, {3.9942457515538425`*^9, 
  3.9942457568341618`*^9}, {3.994245814873949*^9, 3.994245912246603*^9}, {
  3.9942459725421944`*^9, 3.9942460097355576`*^9}, {3.994246294536957*^9, 
  3.9942463188318405`*^9}, {3.994246848385872*^9, 
  3.994246858180979*^9}},ExpressionUUID->"b1602d22-51e4-f14f-b95a-\
a57af76d5d84"],

Cell[TextData[{
 " && logical ",
 StyleBox["and",
  FontWeight->"Bold"],
 " operator. This allows you to combine multiple statements, will only \
evaluate ",
 StyleBox["True",
  FontWeight->"Bold"],
 " if all statements are ",
 StyleBox["True. ",
  FontWeight->"Bold"],
 "You can also use the character \[OpenCurlyDoubleQuote]\[And]\
\[CloseCurlyDoubleQuote] by pressing ",
 StyleBox["Esc, ",
  FontWeight->"Bold"],
 "typing \[OpenCurlyDoubleQuote]and\[CloseCurlyDoubleQuote], and hitting ",
 StyleBox["Esc ",
  FontWeight->"Bold"],
 "again. "
}], "Text",
 CellChangeTimes->{{3.9942463459820614`*^9, 3.994246363106497*^9}, {
   3.994246450824892*^9, 3.9942465024729443`*^9}, {3.994246698438307*^9, 
   3.994246701656948*^9}, {3.9942469311605625`*^9, 3.9942469833899345`*^9}, {
   3.99424701689641*^9, 3.9942471020874233`*^9}, 
   3.994247205256874*^9},ExpressionUUID->"d18064ff-4f47-3841-b669-\
e320dca8bddf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"1", " ", "==", "1"}], " ", "&&", " ", 
  RowBox[{"2", " ", "==", " ", "2"}], " ", "\[And]", " ", 
  RowBox[{"3", " ", "==", " ", "3", " ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"returns", " ", "true", " ", "because", " ", "1"}], "=", "1"}], 
     ",", " ", 
     RowBox[{"2", "=", "2"}], ",", " ", 
     RowBox[{
      RowBox[{"and", " ", "3"}], "=", 
      RowBox[{"3", " ", "are", " ", "all", " ", "true", " ", "statemens"}]}], 
     ",", " ", 
     RowBox[{
      RowBox[{"you", " ", "can", " ", "use", " ", "both"}], " ", "&&", " ", 
      "and", " ", "\[And]", " ", 
      RowBox[{"in", " ", "the", " ", "same", " ", "statement"}]}]}], 
    "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.9942463459820614`*^9, 3.9942463780266495`*^9}, {
  3.994246414603607*^9, 3.994246472059263*^9}, {3.994246504677494*^9, 
  3.994246530746422*^9}, {3.9942470131489067`*^9, 3.994247014708008*^9}, {
  3.994247073738846*^9, 
  3.9942470857954617`*^9}},ExpressionUUID->"319ad7d5-d841-014a-887d-\
1489769946bb"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{
  3.994246439071348*^9, {3.9942465089635735`*^9, 3.994246533414549*^9}},
 CellLabel->"Out[23]=",ExpressionUUID->"1f37251f-dc7e-0d48-ad7d-5c2b75ff8a07"]
}, Open  ]],

Cell[TextData[{
 "|| logical ",
 StyleBox["or ",
  FontWeight->"Bold"],
 "operator. This also allows you to combine multiple statements, will \
evaluate ",
 StyleBox["True ",
  FontWeight->"Bold"],
 "if at least one of the statements involved is ",
 StyleBox["True",
  FontWeight->"Bold"],
 ". You can also use the character \[OpenCurlyDoubleQuote]\[Or]\
\[CloseCurlyDoubleQuote] by pressing ",
 StyleBox["Esc, ",
  FontWeight->"Bold"],
 "typing \[OpenCurlyDoubleQuote]or\[CloseCurlyDoubleQuote], and hitting ",
 StyleBox["Esc ",
  FontWeight->"Bold"],
 "again. "
}], "Text",
 CellChangeTimes->{{3.99424712385322*^9, 
  3.994247214892521*^9}},ExpressionUUID->"dedcb2ef-3a22-4d44-ac28-\
202951df707c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"1", " ", "==", "0"}], " ", "||", " ", 
  RowBox[{"1", "==", " ", "1"}], "||", " ", 
  RowBox[{"1", " ", "==", " ", "2", "  ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"evaluates", " ", "true", " ", "because", " ", "1"}], "=", 
      "1"}], ",", " ", 
     RowBox[{
     "even", " ", "though", " ", "the", " ", "other", " ", "statements", " ", 
      "are", " ", "false"}]}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.9942471314982185`*^9, 3.994247137415472*^9}, {
  3.9942472185440693`*^9, 
  3.994247257949215*^9}},ExpressionUUID->"738686fb-8fa2-4749-9e81-\
a92b0f89ead0"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{3.9942472418928566`*^9},
 CellLabel->"Out[28]=",ExpressionUUID->"bc23a5b8-c436-4a4a-a353-b6a17b1f8a3b"]
}, Open  ]],

Cell[TextData[{
 "There are also some other of the less common, though useful logical \
operators such as ",
 StyleBox["Xor ",
  FontWeight->"Bold"],
 "and ",
 StyleBox["Nor",
  FontWeight->"Bold"],
 ", check the documentation for information on these logical operators. "
}], "Text",
 CellChangeTimes->{{3.9942472640850964`*^9, 3.9942472796088696`*^9}, {
  3.994247311624895*^9, 3.9942473501389847`*^9}, {3.9942502628254223`*^9, 
  3.9942502811522217`*^9}},ExpressionUUID->"f3704f02-6489-3449-abf5-\
78f3c28411f1"],

Cell[CellGroupData[{

Cell["Conditionals", "Subsubsection",
 CellChangeTimes->{{3.994250299179331*^9, 
  3.9942503087695713`*^9}},ExpressionUUID->"002b8295-84c8-8c42-b9d9-\
6fff0a5fadd6"],

Cell[TextData[{
 "Like other programming languages, Mathematica can use conditional \
statements that will only execute code if a condition is met. The ",
 StyleBox["If",
  FontWeight->"Bold"],
 " conditional has the syntax ",
 StyleBox["If[",
  FontWeight->"Bold"],
 "<condition>,<true output>,<false output>",
 StyleBox["].",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.9942503562132034`*^9, 3.9942503685826645`*^9}, {
  3.9942504155405006`*^9, 3.9942504507554913`*^9}, {3.994250603123457*^9, 
  3.9942506202643433`*^9}, {3.994250678203539*^9, 3.9942506899086037`*^9}, {
  3.994250775922392*^9, 3.994250801274254*^9}, {3.9942508415434685`*^9, 
  3.9942509095834217`*^9}, {3.9942510037233276`*^9, 
  3.994251030170477*^9}},ExpressionUUID->"faf05ead-1f3a-ef47-9c9d-\
5fb2bb81e957"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"EvenQ", "[", "4", "]"}], ",", " ", "\"\<4 is even\>\"", ",", 
    " ", "\"\<4 is odd\>\""}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"outputs", " ", "string", " ", "\"\<4 is even\>\""}], ",", " ", 
    RowBox[{
    "EvenQ", " ", "returns", " ", "true", " ", "if", " ", "the", " ", "input",
      " ", "is", " ", "even"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"EvenQ", "[", "3", "]"}], ",", "\"\<3 is even\>\"", ",", 
    " ", "\"\<3 is odd\>\""}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"outputs", " ", "string", " ", "\"\<3 is odd\>\""}], 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{3.994250299179331*^9, 3.994250305166546*^9}, {
  3.9942503713734913`*^9, 3.994250372758396*^9}, {3.9942510443866863`*^9, 
  3.9942511463871536`*^9}, {3.9942512069946423`*^9, 3.9942512143421097`*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"422ee629-7c1b-4b49-b610-976c0ca21a85"],

Cell[BoxData["\<\"4 is even\"\>"], "Output",
 CellChangeTimes->{3.9942510831453953`*^9, 3.994251214830614*^9},
 CellLabel->"Out[42]=",ExpressionUUID->"57f1cf00-88c9-2645-8169-23ee5a212740"],

Cell[BoxData["\<\"3 is odd\"\>"], "Output",
 CellChangeTimes->{3.9942510831453953`*^9, 3.994251214830614*^9},
 CellLabel->"Out[43]=",ExpressionUUID->"713fed39-c273-d14d-b062-982fc07382ff"]
}, Open  ]],

Cell["\<\
Since you can put undefined variables in a statement, you can add an \
additional output if Mathematica fails to assign a truth value to the \
condition:\
\>", "Text",
 CellChangeTimes->{{3.9942512657166634`*^9, 3.994251322384632*^9}, {
  3.9942516724038734`*^9, 
  3.9942516813716755`*^9}},ExpressionUUID->"bf8c699f-d9ec-b94b-8a72-\
572f23a1667c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"a", ",", "b"}], "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"a", "<", "b"}], ",", "\"\<a is less than b\>\"", 
    ",", "\"\<a is not less than b\>\"", 
    ",", "\"\<Either a or b are not defined, please make sure they have \
definite values.\>\""}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "prints", " ", "out", " ", "the", " ", "last", " ", "string", " ", 
     "since", " ", "we", " ", "have", " ", "defined", " ", "a", " ", "or", " ",
      "b"}], ",", " ", 
    RowBox[{
    "and", " ", "Mathematica", " ", "cannot", " ", "assign", " ", "a", " ", 
     "truth", " ", "value"}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9942512657166634`*^9, 3.9942514441975174`*^9}, {
  3.994251684490879*^9, 
  3.9942516871607304`*^9}},ExpressionUUID->"84ec012d-94a7-734a-825c-\
5af566d080ba"],

Cell[BoxData["\<\"Either a or b are not defined, please make sure they have \
definite values\"\>"], "Output",
 CellChangeTimes->{{3.99425140566918*^9, 3.994251421647993*^9}},
 CellLabel->"Out[45]=",ExpressionUUID->"c730f14e-37bd-7d4d-8608-1db7357db6ee"]
}, Open  ]],

Cell[TextData[{
 "If you have more than two possibilities for you conditions, you will have \
to use the ",
 StyleBox["Switch ",
  FontWeight->"Bold"],
 "statement. This has the syntax ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["Switch",
     FontWeight->"Bold"], 
    StyleBox["[",
     FontWeight->"Bold"], 
    RowBox[{
     RowBox[{
      StyleBox["<",
       FontWeight->"Bold"], "expression", ">"}], ",", 
     RowBox[{"<", 
      SubscriptBox["form", "1"], ">"}], ",", 
     RowBox[{"<", 
      SubscriptBox["value", "1"], ">"}], ",", 
     RowBox[{"<", 
      SubscriptBox["form", "2"], ">"}], ",", 
     RowBox[{"<", 
      SubscriptBox["value", "2"]}]}]}], TraditionalForm]],ExpressionUUID->
  "c997940d-786d-0f4b-8af4-9e71bd6f5995"],
 ">, ...",
 StyleBox["]. \n",
  FontWeight->"Bold"],
 "Switch will then compare <expression> to each ",
 Cell[BoxData[
  FormBox[
   RowBox[{"<", 
    SubscriptBox["form", "i"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "34c2c74c-460a-4bc4-9c75-fc97f52f887c"],
 "> until it finds a match. It will then execute the corresponding ",
 Cell[BoxData[
  FormBox[
   RowBox[{"<", 
    SubscriptBox["value", "i"]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "74fde047-b0cb-48d8-91cd-3d818eae88d9"],
 ">. "
}], "Text",
 CellChangeTimes->{{3.9942517155893097`*^9, 3.994251783323683*^9}, {
  3.994251908007614*^9, 3.9942519747679577`*^9}, {3.9942520238501453`*^9, 
  3.994252117940504*^9}, {3.994343367634309*^9, 3.994343395826379*^9}, {
  3.994343535683237*^9, 3.994343539266192*^9}, {3.994344962643948*^9, 
  3.994345021467963*^9}},ExpressionUUID->"82c41331-9308-0c44-ba00-\
7af558f27683"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"initialize", " ", "x", " ", "variable"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "x", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x", " ", "=", " ", "2"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Switch", "[", 
    RowBox[{
    "x", ",", " ", "0", ",", " ", "\"\<x = 0\>\"", ",", "1", " ", ",", 
     " ", "\"\<x = 1\>\"", ",", " ", "2", ",", "\"\<x = 2\>\""}], "]"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "This", " ", "will", " ", "output", " ", "the", " ", "string", 
     " ", "\"\<x = 2\>\""}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.9942517155893097`*^9, 3.994251783323683*^9}, {
  3.994251908007614*^9, 3.9942519747679577`*^9}, {3.9942520238501453`*^9, 
  3.994252117940504*^9}, {3.994343367634309*^9, 3.994343395826379*^9}, {
  3.994343535683237*^9, 3.994343543804541*^9}, {3.994343702633019*^9, 
  3.994343712581544*^9}, {3.9943439597072153`*^9, 3.9943440337280283`*^9}, {
  3.994344372702633*^9, 
  3.994344375086555*^9}},ExpressionUUID->"f46cc171-7c57-4f77-9214-\
4c0efb77c56c"],

Cell[BoxData["\<\"x = 2\"\>"], "Output",
 CellChangeTimes->{3.994344028037857*^9},
 CellLabel->"Out[9]=",ExpressionUUID->"c21240a8-41df-4dfd-8ba0-7c26e80e8879"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Switch",
  FontWeight->"Bold"],
 " will only evaluate on the first met condition. Below is an example of how \
this could be limiting, though it can be useful as well. The _? before a \
command is simply telling Mathematica to take the expression and apply the \
test to it. In the case below, Mathematica asks if 5 is even, if it is odd, \
and if it is an integer. "
}], "Text",
 CellChangeTimes->{{3.9942517155893097`*^9, 3.994251783323683*^9}, {
   3.994251908007614*^9, 3.9942519747679577`*^9}, {3.9942520238501453`*^9, 
   3.994252117940504*^9}, {3.994343367634309*^9, 3.994343395826379*^9}, {
   3.994343535683237*^9, 3.994343545640853*^9}, 3.994343716609029*^9, {
   3.994343819441648*^9, 3.994343846365993*^9}, {3.9943441011802263`*^9, 
   3.9943441728205633`*^9}, {3.994344204917136*^9, 3.994344240997266*^9}, {
   3.9943445804042177`*^9, 3.994344581832252*^9}, {3.994345103676206*^9, 
   3.994345146344997*^9}},ExpressionUUID->"ba6816a1-cba1-42ec-90a1-\
a82192a8d497"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Switch", "[", 
   RowBox[{"5", ",", 
    RowBox[{"_", "?", "EvenQ"}], ",", "\"\<5 is even\>\"", ",", " ", 
    RowBox[{"_", "?", "OddQ"}], ",", " ", "\"\<5 is odd\>\"", ",", " ", 
    RowBox[{"_", "?", "IntegerQ"}], ",", " ", "\"\<5 is an integer\>\""}], 
   "\[IndentingNewLine]", "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "will", " ", "output", " ", "the", " ", "string", 
    " ", "\"\<5 is odd\>\""}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.9942517155893097`*^9, 3.994251779926903*^9}, {
   3.994252132498625*^9, 3.9942521407222004`*^9}, {3.9942566070834656`*^9, 
   3.9942566912709694`*^9}, 3.994329754887765*^9, {3.99434325644147*^9, 
   3.9943433059619503`*^9}, {3.994343348073662*^9, 3.994343364514265*^9}, {
   3.99434341039886*^9, 3.9943434128905153`*^9}, {3.99434345097477*^9, 
   3.994343458006714*^9}, {3.99434350517552*^9, 3.994343527955611*^9}, {
   3.994343874850371*^9, 3.9943439572878838`*^9}, {3.9943443637425833`*^9, 
   3.9943443696745453`*^9}, {3.994344405167103*^9, 
   3.994344445083177*^9}},ExpressionUUID->"dd60fc6a-93a2-e74a-a8da-\
c4c97ee24523"],

Cell[BoxData["\<\"5 is odd\"\>"], "Output",
 CellChangeTimes->{{3.9943439541124783`*^9, 3.99434395773704*^9}, 
   3.994344417446344*^9},
 CellLabel->"Out[10]=",ExpressionUUID->"d9aef96e-4feb-4a94-bf71-73330c7bc4d6"]
}, Open  ]],

Cell[TextData[{
 "We see that even though 5 is both odd and an integer, only the string \
\[OpenCurlyDoubleQuote]5 is odd\[CloseCurlyDoubleQuote] is output because \
Mathematica only evaluated on the condition, \[OpenCurlyDoubleQuote]5 is an \
odd number\[CloseCurlyDoubleQuote] because it was first in our order of \
checking conditions. Just something to keep in mind while you are using this. \
\n\nIn a similar vein, there is the ",
 StyleBox["Which",
  FontWeight->"Bold"],
 " command. The ",
 StyleBox["Which ",
  FontWeight->"Bold"],
 "command works similarly to the ",
 StyleBox["Switch ",
  FontWeight->"Bold"],
 "command. The difference is that you are not comparing a single <expression> \
to multiple <forms>. Instead, you are just checking a series of test cases \
until one is true. "
}], "Text",
 CellChangeTimes->{{3.994344244318437*^9, 3.9943442489729853`*^9}, {
  3.994344357966176*^9, 3.994344608472364*^9}, {3.994344640216736*^9, 
  3.994344774577874*^9}, {3.994344904934721*^9, 3.9943449501553793`*^9}, {
  3.9943450578398113`*^9, 3.994345099152581*^9}, {3.9943451543528547`*^9, 
  3.994345206433408*^9}, {3.9943452543338537`*^9, 
  3.994345332630595*^9}},ExpressionUUID->"c369e178-b65c-427e-b7f0-\
993581993ea9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"x", ",", "y"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", "=", " ", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"y", " ", "=", " ", "2"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Which", "[", 
   RowBox[{
    RowBox[{"EvenQ", "[", "x", "]"}], ",", "\"\<x is even\>\"", ",", " ", 
    RowBox[{"OddQ", "[", "x", "]"}], ",", " ", "\"\<x is odd\>\"", ",", " ", 
    RowBox[{"EvenQ", "[", "y", "]"}], ",", " ", "\"\<y is even\>\""}], "]"}], 
  " ", 
  RowBox[{"(*", 
   RowBox[{
   "will", " ", "output", " ", "the", " ", "string", 
    " ", "\"\<x is odd\>\""}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.994344244318437*^9, 3.9943442489729853`*^9}, {
  3.994344357966176*^9, 3.994344608472364*^9}, {3.994344640216736*^9, 
  3.9943448185863867`*^9}, {3.994345208909446*^9, 3.994345248905957*^9}, {
  3.994345368471002*^9, 
  3.9943453690950317`*^9}},ExpressionUUID->"ff5c82e8-2313-4338-b572-\
199baf4093b7"],

Cell[BoxData["\<\"x is odd\"\>"], "Output",
 CellChangeTimes->{{3.99434479781707*^9, 3.994344819328335*^9}, {
  3.994345225533781*^9, 3.9943452456737537`*^9}},
 CellLabel->"Out[20]=",ExpressionUUID->"8d49bd08-1ac0-4dc7-9be1-26a89cf925d9"]
}, Open  ]],

Cell[TextData[{
 "Like with ",
 StyleBox["Switch",
  FontWeight->"Bold"],
 ", only the first met condition is evaluated on. Even though y = 2 is even, \
because we saw that x is odd first, that is the only condition that executes \
code. "
}], "Text",
 CellChangeTimes->{{3.994345337463376*^9, 
  3.9943454337394323`*^9}},ExpressionUUID->"2fd6a356-e319-486a-8678-\
295941ba202a"]
}, Closed]],

Cell[CellGroupData[{

Cell["Loops", "Subsubsection",
 CellChangeTimes->{{3.9943454465006227`*^9, 
  3.994345479312838*^9}},ExpressionUUID->"4c155b6f-85cc-43b0-9962-\
814fc80a5b4d"],

