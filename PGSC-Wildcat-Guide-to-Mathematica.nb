3a3297119f3c"],

Cell[CellGroupData[{

Cell["Clearing and Suppressing Output", "Subsubsection",
 CellChangeTimes->{{3.9762782124740696`*^9, 3.9762782187110214`*^9}, 
   3.976278405517706*^9, {3.9762784716147175`*^9, 
   3.9762784844114227`*^9}},ExpressionUUID->"dffd3f4a-735a-f24d-9b2e-\
e203f0a28368"],

Cell["\<\
Mathematica will output each and every line of evaluated code. For large data \
sets and complicated numerical calculations, this can be cumbersome. However, \
we can suppress output by using a semi-colon ;

Try evaluating the code below and notice that Mathematica will not generate \
an output cell\
\>", "Text",
 CellChangeTimes->{{3.9762782124740696`*^9, 3.9762782187110214`*^9}, {
  3.9762784346727505`*^9, 3.976278535750786*^9}, {3.9762786409492188`*^9, 
  3.9762786659331207`*^9}, {3.9762787033577366`*^9, 
  3.976278738675272*^9}},ExpressionUUID->"16ce0dfd-e949-7d48-8efc-\
927bb35342ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{"15851910237", "+", " ", "120957"}], ";"}]], "Input",
 CellChangeTimes->{{3.9762782124740696`*^9, 3.9762782187110214`*^9}, {
  3.9762784346727505`*^9, 3.976278535750786*^9}, {3.9762786409492188`*^9, 
  3.9762786991044216`*^9}, {3.976278818476368*^9, 3.9762788277573757`*^9}, {
  3.9762788633154488`*^9, 3.9762788779294834`*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"8f8d8e3f-ec61-ad40-92f9-47470a6c93b9"],

Cell["\<\
However, the cell still evaluated and we can call the value that Mathematica \
calculated using %\
\>", "Text",
 CellChangeTimes->{{3.9762787605867977`*^9, 
  3.976278871167347*^9}},ExpressionUUID->"f0844f54-bd3c-c346-839c-\
5cfdeedf4048"],

Cell[BoxData["%"], "Input",
 CellChangeTimes->{{3.9762787605867977`*^9, 3.97627878184639*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"1a4a4be5-bca7-d842-8df9-6b5d3e482a1c"],

Cell[TextData[{
 "We can also delete outputs by selecting the output cell bracket found on \
the right hand side, ",
 Cell[BoxData[
  GraphicsBox[
   TagBox[RasterBox[CompressedData["
1:eJzt178LgkAUB3CppbE1mvoD9JaGlgahpRyCfgy6GZ4ShIEXSIuz5GSb/bW9
OBA7Nel0Kd4XT/TkPjw9lzc5nDduT1EUNoDTxg71ILCv2yHc7H129HzqLP0L
9WgwO/Rhcg5jDON1PaqPYRju8RTd7pXHYrX+sLYcTdPiOH7UhxDyFQhRVTVJ
ElhrmiYphFIqB3KT1wmvn09aliUNVpotwbLZHhTMTsCiyRjrBCyaXYHcTNOU
/0vSiPmeKIqyLNN1XRrkuyCkDUje4zhOyworC+5qUxBEEEEEEUQQQQQRRBDB
/wZh1a6UMAyLoPC0ESz3UELzKPRZjeC0JjkozEt8B8zP5QlhDdTv
     "], {{0, 36.6}, {16.2, 0}}, {0, 255},
     ColorFunction->RGBColor,
     ImageResolution->{120., 120.},
     RasterInterpolation->"High"],
    BoxForm`ImageTag["Byte", ColorSpace -> "RGB", Interleaving -> True],
    Selectable->False],
   DefaultBaseStyle->"ImageGraphics",
   ImageSize->Automatic,
   ImageSizeRaw->{16.2, 36.6},
   PlotRange->{{0, 16.2}, {0, 36.6}}]], "Input",ExpressionUUID->
  "cc112b41-68b9-ac49-a47c-7b741c60040c"],
 ", pressing the delete key. To delete all output, you can got to the ",
 StyleBox["Cell",
  FontWeight->"Bold"],
 " tab and click ",
 StyleBox["Delete All Output.",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.9762788884046345`*^9, 3.976278993810583*^9}, 
   3.976279033488989*^9, 3.97627921462232*^9, {3.993725252438752*^9, 
