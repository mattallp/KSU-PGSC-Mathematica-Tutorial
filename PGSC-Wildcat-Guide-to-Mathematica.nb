6a84e08eaabe"],

Cell[TextData[{
 StyleBox["Here, you can practice writing your own code. Possible solutions \
to exercises will also be included. \n\n", "Subsubtitle"],
 StyleBox["This is a work-in-progress.", "Subsubtitle",
  FontWeight->"Bold"],
 StyleBox["  Currently, only the first 3 sections are completed. I hope to \
have the rest completed soon, you can find the latest updates and progress on \
the ", "Subsubtitle"],
 StyleBox[ButtonBox["GitHub page",
  BaseStyle->"Hyperlink",
  ButtonData->{
    URL["https://github.com/mattallp/KSU-PGSC-Mathematica-Tutorial"], None},
  ButtonNote->"https://github.com/mattallp/KSU-PGSC-Mathematica-Tutorial"], 
  "Subsubtitle"],
 StyleBox[".\nIf you have any issues, questions, or suggestions, please reach \
out to me at mattallp@ksu.edu or over Discord. \nHopefully, you will find \
this guide helpful! \n\n-Matthew Allphin, PGSC Academic Chair 2026-2027", 
  "Subsubtitle"]
}], "Text",
 CellChangeTimes->{{3.976274435054739*^9, 3.9762744542237396`*^9}, {
   3.9762745321428413`*^9, 3.9762745331717167`*^9}, 3.9762745662759724`*^9, {
