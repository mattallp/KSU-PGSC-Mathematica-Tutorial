  3.993731839342368*^9}},ExpressionUUID->"3c998a8e-a363-473c-a2c0-\
6c11f28d0001"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Efield3D", "[", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], "=", " ", 
    RowBox[{
     FractionBox["1", 
      SuperscriptBox[
       RowBox[{"Sqrt", "[", 
        RowBox[{
         SuperscriptBox["x", "2"], "+", 
         SuperscriptBox["y", "2"]}], "]"}], "3"]], 
     RowBox[{"{", 
      RowBox[{"x", ",", "y", ",", "z"}], "}"}]}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "a", " ", "simple", " ", "3", "D", " ", "Electric", " ", "field", " ", 
    "for", " ", "a", " ", "positive", " ", "charge", " ", "at", " ", "the", " ",
     "origin"}], "*)"}], " "}], "\[IndentingNewLine]", 
 RowBox[{"VectorPlot3D", "[", 
  RowBox[{
   RowBox[{"Efield3D", "[", 
    RowBox[{"x", ",", "y", ",", "z"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
