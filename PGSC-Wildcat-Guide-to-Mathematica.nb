  "In[267]:=",ExpressionUUID->"d46f3b47-4b53-43b9-b48e-b8f7078f2444"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"V", "[", 
     RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], "=", " ", 
    RowBox[{
     SuperscriptBox["x", "2"], "+", 
     SuperscriptBox["y", "2"], "+", 
