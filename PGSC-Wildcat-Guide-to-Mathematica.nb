Cell["\<\
There is also a numerical differential equation solver which we will look \
more at in section VI . \
\>", "Text",
 CellChangeTimes->{{3.994156496223364*^9, 
  3.994156498583192*^9}},ExpressionUUID->"d00e83d1-2d9e-4376-999e-\
ec0c74e4bf3d"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Units in Mathematica", "Subsection",
 CellChangeTimes->{{3.9930421196751003`*^9, 3.993042131298155*^9}, 
   3.993042675870617*^9},ExpressionUUID->"8931a446-edc1-6940-a74e-\
438190ea0c10"],

Cell[TextData[{
 "To end this section, we are going to go over how you can use units in \
Mathematica. Mathematica has a lot of built-in units. The way you can make \
use of them is using the ",
 StyleBox["Quantity[<Magnitude>,\[CloseCurlyDoubleQuote]<UnitName>\
\[CloseCurlyDoubleQuote]]",
  FontWeight->"Bold"],
 " command:"
}], "Text",
 CellChangeTimes->{{3.9930426814403973`*^9, 3.9930427706030807`*^9}, {
  3.993550239525461*^9, 3.993550350522292*^9}, {3.993550576644125*^9, 
  3.9935506003044853`*^9}},ExpressionUUID->"9ec542e5-6e1e-204c-8a6e-\
c44a40a1bcf7"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{"m", " ", "=", " ", 
  RowBox[{"Quantity", "[", 
   RowBox[{"10", ",", "\"\<Kilograms\>\""}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"define", " ", "a", " ", "mass", " ", "of", " ", "10", " ", "kg"}],
    "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9930421196751003`*^9, 3.993042131298155*^9}, {
   3.99304267641881*^9, 3.9930426764218216`*^9}, {3.993550357226639*^9, 
   3.993550390546649*^9}, 3.993550447865651*^9, {3.993550544812284*^9, 
   3.993550594592575*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"12295900-d459-2b48-a479-84ed23a4ebaf"],

Cell["\<\
Mathematica can use compound units and will correctly handle units when doing \
calculations. It can even handle unit conversions:\
\>", "Text",
 CellChangeTimes->{{3.993550606837721*^9, 3.99355065867667*^9}, {
  3.993550751650008*^9, 3.9935507526175623`*^9}, {3.993550944507321*^9, 
  3.993550982855563*^9}},ExpressionUUID->"0856a809-bac5-4407-bffd-\
454f40d4cdd7"],

Cell[BoxData[
 RowBox[{"g", " ", "=", " ", 
  RowBox[{"Quantity", "[", 
   RowBox[{"32.2", ",", 
    RowBox[{"\"\<Feet\>\"", "/", 
     RowBox[{"\"\<Seconds\>\"", "^", "2"}]}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "Define", " ", "the", " ", "acceleration", " ", "due", " ", "to", " ", 
    "gravity", " ", "on", " ", "Earth", " ", "to", " ", "be", " ", "32.2", " ", 
    RowBox[{"ft", "/", 
     SuperscriptBox["s", "2"]}]}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.993550606837721*^9, 3.99355065867667*^9}, {
  3.993550751650008*^9, 3.9935507526175623`*^9}, {3.993550944507321*^9, 
  3.993550950369297*^9}, {3.9935509859397984`*^9, 3.993551151902301*^9}, {
  3.9935514164995604`*^9, 
  3.993551418807437*^9}},ExpressionUUID->"b939ea2c-cf3d-4a29-bfc5-\
4323b9907a5b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Convert", " ", "g", " ", "to", " ", 
    RowBox[{"m", "/", 
     SuperscriptBox["s", "2"]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"UnitConvert", "[", 
   RowBox[{"g", ",", " ", 
    RowBox[{"\"\<Meters\>\"", "/", 
     SuperscriptBox["\"\<Seconds\>\"", "2"]}]}], "]"}], " "}]], "Input",
 CellChangeTimes->{{3.993550606837721*^9, 3.99355065867667*^9}, {
  3.993550751650008*^9, 3.9935507526175623`*^9}, {3.993550944507321*^9, 
  3.993550950369297*^9}, {3.9935509859397984`*^9, 3.993551151902301*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"bdaee71e-7c31-4b5d-84c9-d8d9ff0b7b15"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Calculate", " ", "the", " ", "weight", " ", "of", " ", "a", " ", "10", " ",
     "kg", " ", "mass", " ", "on", " ", "Earth"}], "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"weight", " ", "=", " ", 
    RowBox[{"m", " ", "g"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Convert", " ", "the", " ", "weight", " ", "to", " ", "Newtons", " ", 
     "and", " ", "pounds"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{"weight", ",", "\"\<Newtons\>\""}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"UnitConvert", "[", 
    RowBox[{"weight", ",", "\"\<PoundsForce\>\""}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.993551157026698*^9, 3.9935512503474483`*^9}, {
  3.993551301450753*^9, 3.993551305350593*^9}, {3.9935514076995783`*^9, 
  3.993551409507388*^9}},ExpressionUUID->"7297a58d-b22f-4a2d-870d-\
93d19a25e51d"],

Cell[TextData[{
 "The unit calculations are not fool-proof however, and sometimes you will \
need will want to just extract the magnitude or the units themselves this can \
be done using the ",
 StyleBox["QuantityMagnitude ",
  FontWeight->"Bold"],
 "and ",
 StyleBox["QuantityUnit ",
  FontWeight->"Bold"],
 "command."
}], "Text",
 CellChangeTimes->{{3.993551340754711*^9, 3.993551342446538*^9}, {
  3.9935513786350317`*^9, 3.993551394430766*^9}, {3.9935514267473927`*^9, 
  3.993551503069446*^9}},ExpressionUUID->"4ec7adff-1600-47af-b8d8-\
5b09c418ccf0"],

Cell[BoxData[
 RowBox[{"  ", 
  RowBox[{
   RowBox[{"QuantityMagnitude", "[", "g", "]"}], " ", 
   RowBox[{"(*", 
    RowBox[{"get", " ", "the", " ", "magnitude", " ", "of", " ", "g", " ", 
     RowBox[{"(", "32.2", ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"QuantityUnit", "[", "m", "]"}], " ", 
   RowBox[{"(*", 
    RowBox[{"get", " ", "the", " ", "unit", " ", "of", " ", "m", " ", 
     RowBox[{"(", "Kilograms", ")"}]}], "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.993551340754711*^9, 3.993551342446538*^9}, {
  3.9935513786350317`*^9, 3.993551394430766*^9}, {3.9935514267473927`*^9, 
  3.993551556660634*^9}},ExpressionUUID->"5c10f8ac-de1a-4edc-935c-\
292b58f1809e"],

Cell["\<\
You can also define your own units, but that is outside the scope of this \
notebook. \
\>", "Text",
 CellChangeTimes->{{3.993553440654335*^9, 
  3.993553465709321*^9}},ExpressionUUID->"15a1d102-d9dd-4b2b-ad44-\
b53b34496edb"],

Cell[CellGroupData[{

Cell["Wolfram|Alpha shortcuts", "Subsubsection",
 CellChangeTimes->{{3.9935518065639677`*^9, 3.9935518266682987`*^9}, {
  3.993551985432747*^9, 
  3.993551992424181*^9}},ExpressionUUID->"525d9148-0f9c-4b51-b2ed-\
4db94b2b7a22"],

Cell[TextData[{
 "For this section, you will want to ensure Dynamic Updating is enabled, see \
Section 0 for instructions on how to do this.  You have probably used or seen \
WolframA|lpha to help with homework from time to time. If you have Dynamic \
Updating enabled, you can access the WolframAlpha directly in Mathematica. \
You can open a Wolfram|Alpha prompt by pressing \[OpenCurlyDoubleQuote]Ctrl + \
=\[CloseCurlyDoubleQuote] in an input cell this will cause a dialog box to \
appear with an orange equals sign: ",
 Cell[BoxData[
  GraphicsBox[
   TagBox[RasterBox[CompressedData["
1:eJzt3L1rU1EYgPGgDo6uGR2zR9LknooBl0iWVJIYJEhLbmsz5KtW6SBFFIJO
We3qol1cHPwLHERxEqQ4OZvJVX3NCURRUs1NfXPPCU/hV9ISOC+c+3BzINzz
G+21zVOJRGLn7OjX2vqdfK+3vnf13OiPcmtne6sVNgqtW+FW2FvZOD36ZzDy
YeRMYvwjAAAAAAAAyyadTgOIiL4APfQF6KEvQA99AXroC9BDX4Ae+gL00Beg
x+W+giCQarUqjUZDOp3OQtk17dp2hrj3CP5ytS9jzPgaL5fLks1mx9f5Itk1
7dp2Bvs67n2Cn1zty9477PW96K7+ZOcoFAqx7xP85Gpfk/tG3H3ZGUqlUuz7
BD+52pc9A8Xd1kStVot9n+An+qIv6KEv+oIeF/p6WM7I1/tG5MG/De8aCa/Q
F/zgQl/fZmxr4ui2oS94wYW+Jt28uGnk0bXgWO93fzV2aZW+4D6X+rpX/vt1
/nI7+PnePH3BA1H7ymQyks/np8rlcnPNMGnmTdfI883jfdoz9AWvRO2r2+2K
fJepDh4fzDVDlLMXfcEnUfsqFovS7/enqtfrc80wz/mLvuADzl/0BT1R+2o2
mzL8PJxqMBjMNQPnLyyrqH1VKhU5fHY4VbvdnmuGqGevL/uBrBr6gvtc+Hx4
tJuL1NfTxuLaoi+chAt9Xc5dkCc3VuR1OytvO7mxj/sFedczv3nVNjK4buTi
Au9d9IWTcKGvafh+L5YBfdEX9NAXfUEPfdEX9LjaF8/fwDJwtS+eH4Vl4Gpf
PP8Qy8DVvizbmL1/hGG48Of32jXt2naGuPcI/nK5L8B39AXooS9AD30BeugL
0ENfgB76AvTQF6CHvgA99AXooS9AD30BembtK5VKAYho1r6SySSAiGbtCwAA
AADw//0AwGsHmQ==
     "], {{0, 59.}, {216., 0}}, {0, 255},
     ColorFunction->RGBColor],
    BoxForm`ImageTag[
    "Byte", ColorSpace -> "RGB", Interleaving -> True, 
     MetaInformation -> <|
      "Comments" -> {
        "Software" -> "gnome-screenshot", "Creation Time" -> 
         DateObject[{2026, 7, 20, 11, 8, 30}, "Instant", "Gregorian", -5.]}|>],
    Selectable->False],
   DefaultBaseStyle->"ImageGraphics",
   ImageSizeRaw->{216., 59.},
   PlotRange->{{0, 216.}, {0, 59.}}]], "Input",ExpressionUUID->
  "31ad11d8-14d4-4901-a82f-8f6b443d0da6"],
 ". Using this you can lookup constants and generate code (though I would be \
wary of the code generation).  You can also write a quantity with units to \
shortcut defining quantities. For example, by typing \
\[OpenCurlyDoubleQuote]permittivity of free space\[CloseCurlyDoubleQuote], I \
can get the constant ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Epsilon]", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "af20fa52-01c6-4b92-9940-007f56cfe4a0"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9935518065639677`*^9, 3.993551873295658*^9}, {
  3.993551923631875*^9, 3.9935519272877417`*^9}, {3.993552009368569*^9, 
  3.99355211007694*^9}, {3.9935521462376013`*^9, 3.9935522776546183`*^9}, {
  3.993552401744166*^9, 3.993552428308004*^9}, {3.993552459278028*^9, 
  3.993552514641099*^9}, {3.993552546179408*^9, 3.993552636429842*^9}, {
  3.9935533197201233`*^9, 
  3.993553381962175*^9}},ExpressionUUID->"aaf2cbe1-dd7f-48d1-88f5-\
8fa201091ddf"],

Cell[BoxData[
 RowBox[{"\[Epsilon]0", " ", "=", " ", 
  TemplateBox[<|
   "query" -> "permitivity of free space", "boxes" -> TemplateBox[{
       InterpretationBox["\[InvisibleSpace]", 1], 
       SubscriptBox["\"\[CurlyEpsilon]\"", "0"], "electric constants", 
       "\"ElectricConstant\""}, "Quantity", SyntaxForm -> Mod], 
    "allassumptions" -> {}, "assumptions" -> {}, "open" -> {1, 2}, 
    "querystate" -> {
     "Online" -> True, "Allowed" -> True, "mparse.jsp" -> 
      0.808781`6.359375933690094, "Messages" -> {}}, "contextinfo" -> 
    Automatic, "version" -> 5|>,
   "LinguisticAssistantTemplate"], " ", 
  RowBox[{"(*", 
   RowBox[{"permittivity", " ", "of", " ", "free", " ", "space"}], 
   "*)"}]}]], "Input",
 CellChangeTimes->{{3.9935518065639677`*^9, 3.993551873295658*^9}, {
  3.993551923631875*^9, 3.9935519272877417`*^9}, {3.993552009368569*^9, 
  3.99355211007694*^9}, {3.9935521462376013`*^9, 3.9935522339268217`*^9}, {
  3.993552280687258*^9, 3.993552285707417*^9}, {3.993552372067501*^9, 
  3.993552374223783*^9}, {3.993552938096758*^9, 3.9935529440207577`*^9}},
 CellLabel->"In[21]:=",ExpressionUUID->"03e8e410-beeb-40bd-b1b1-53b8201eb533"],

Cell["\<\
And by writing \[OpenCurlyDoubleQuote]10 V\[CloseCurlyDoubleQuote] I can get \
a quantity representing 10 Volts\
\>", "Text",
 CellChangeTimes->{{3.993553374716606*^9, 
  3.993553408672773*^9}},ExpressionUUID->"c2f6d038-20c2-4b71-86c2-\
3b782fd4548d"],

Cell[BoxData[
 RowBox[{"V", " ", "=", " ", 
  TemplateBox[<|
   "query" -> "10 V", "boxes" -> 
    TemplateBox[{"10", "\"V\"", "volts", "\"Volts\""}, "Quantity", SyntaxForm -> 
      Mod], "allassumptions" -> {{
      "type" -> "Clash", "word" -> "V", "template" -> 
       "Assuming \"V\" is a unit${separator}Use as ${desc} or ${desc} \
instead", "count" -> "3", "pulldown" -> "false", "default" -> 
       "{\"C\", \"V\"} -> {\"Unit\", \"dflt\"}", 
       "Values" -> {{
         "name" -> "Unit", "desc" -> "a unit", "input" -> 
          "{\"C\", \"V\"} -> {\"Unit\"}"}, {
         "name" -> "Variable", "desc" -> "a variable", "input" -> 
          "{\"C\", \"V\"} -> {\"Variable\"}"}, {
         "name" -> "RomanNumeral", "desc" -> "a roman numeral", "input" -> 
          "{\"C\", \"V\"} -> {\"RomanNumeral\"}"}}}, {
      "type" -> "Unit", "word" -> "V", "template" -> 
       "Assuming volts for \"V\"${separator}Use ${desc} instead", "count" -> 
       "2", "pulldown" -> "false", "default" -> 
       "\"UnitClash\" -> {\"V\", {\"Volts\", \"dflt\"}}", 
       "Values" -> {{
         "name" -> "Volts", "desc" -> "volts", "input" -> 
          "\"UnitClash\" -> {\"V\", {\"Volts\"}}"}, {
         "name" -> "LargeVreebles", "desc" -> "large vreebles", "input" -> 
          "\"UnitClash\" -> {\"V\", {\"LargeVreebles\"}}"}}}}, 
    "assumptions" -> {}, "open" -> {1, 2}, 
    "querystate" -> {
     "Online" -> True, "Allowed" -> True, "mparse.jsp" -> 
      0.66893`6.276925667012215, "Messages" -> {}}, "contextinfo" -> 
    Automatic, "version" -> 5|>,
   "LinguisticAssistantTemplate"]}]], "Input",
 CellChangeTimes->{{3.993553411544979*^9, 3.993553417749071*^9}},
 CellLabel->"In[20]:=",ExpressionUUID->"b3b148ce-95be-483a-be57-6b5fdaa263b2"],

Cell["\<\
Another cool feature of this is that even if you have a typo in what you are \
trying to get, Mathematica may still be able to figure it out. Again, \
however, this is not fool-proof. The check-mark next to the box is their for \
you to confirm that Mathematica\[CloseCurlyQuote]s interpretation of what you \
wrote is correct. There is a large amount of information that Wolfram|Alpha \
has access to, so if there is a constant or something you need, just try \
searching for it in Mathematica:\
\>", "Text",
 CellChangeTimes->{{3.993552638915223*^9, 3.9935526551096888`*^9}, {
  3.9935527333347816`*^9, 
  3.993552885104067*^9}},ExpressionUUID->"aafe237d-90f0-4e85-9511-\
fdc8cc9dbb58"],

Cell[BoxData[
 RowBox[{
  TemplateBox[<|"query" -> "Image of a dog", "boxes" -> RowBox[{
       TemplateBox[{"\"dog\"", 
         RowBox[{"Entity", "[", 
           
           RowBox[{"\"TaxonomicSpecies\"", ",", 
             "\"CanisLupusFamiliaris::4t62p\""}], "]"}], 
         "\"Entity[\\\"TaxonomicSpecies\\\", \
\\\"CanisLupusFamiliaris::4t62p\\\"]\"", "\"species specification\""}, 
        "Entity"], "[", 
       TemplateBox[{"\"image\"", 
         RowBox[{"EntityProperty", "[", 
           RowBox[{"\"TaxonomicSpecies\"", ",", "\"Image\""}], "]"}], 
         "\"EntityProperty[\\\"TaxonomicSpecies\\\", \\\"Image\\\"]\""}, 
        "EntityProperty"], "]"}], "allassumptions" -> {}, "assumptions" -> {},
     "open" -> {1, 2}, 
    "querystate" -> {
     "Online" -> True, "Allowed" -> True, "mparse.jsp" -> 
      0.920269`6.415459786210681, "Messages" -> {}}, "contextinfo" -> 
    Automatic, "version" -> 5|>,
   "LinguisticAssistantTemplate"], " ", 
  RowBox[{"(*", 
   RowBox[{
   "This", " ", "is", " ", "what", " ", "happens", " ", "when", " ", "I", " ",
     "ask", " ", "for", " ", "an", " ", "image", " ", "of", " ", "a", " ", 
    "dog"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.993552638915223*^9, 3.9935526551096888`*^9}, {
  3.9935527333347816`*^9, 3.993552872279923*^9}, {3.9935529472848473`*^9, 
  3.993552957168827*^9}},ExpressionUUID->"bd115a6b-95ee-4b70-9d91-\
48744b200c35"],

Cell[BoxData[
 RowBox[{
  TemplateBox[<|
   "query" -> "generate a plot of sin(x)", "boxes" -> RowBox[{"Plot", "[", 
       RowBox[{
         RowBox[{"Sin", "[", "x", "]"}], ",", " ", 
         RowBox[{"{", 
           RowBox[{"x", ",", " ", 
             RowBox[{
               RowBox[{"-", "2"}], "*", "Pi"}], ",", " ", 
             RowBox[{"2", "*", "Pi"}]}], "}"}]}], "]"}], 
    "allassumptions" -> {}, "assumptions" -> {}, "open" -> {1, 2}, 
    "querystate" -> {
     "Online" -> True, "Allowed" -> True, "mparse.jsp" -> 
      0.779868`6.343566093977617, "Messages" -> {}}, "contextinfo" -> 
    Automatic, "version" -> 5|>,
   "LinguisticAssistantTemplate"], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "here", " ", "is", " ", "an", " ", "example", " ", "of", " ", "when", " ",
      "I", " ", "ask", " ", "to", " ", "generate", " ", "code"}], ",", " ", 
    RowBox[{
    "I", " ", "asked", " ", "it", " ", "to", " ", "generate", " ", "a", " ", 
     "plot", " ", "of", " ", "sin", 
     RowBox[{"(", "x", ")"}]}]}], "*)"}]}]], "Input",
 CellChangeTimes->{
  3.99355292742327*^9, {3.993552959324676*^9, 
   3.993552979313081*^9}},ExpressionUUID->"08d0b82a-b3a6-48b3-a301-\
caa1b815d2cc"]
}, Closed]],

Cell[CellGroupData[{

Cell["Exercise", "Subsubsection",
 CellChangeTimes->{{3.9935529877369757`*^9, 
  3.993552991726715*^9}},ExpressionUUID->"1637ca07-7d68-4770-adaf-\
f54f5afa6d2e"],

Cell[TextData[{
 "For this exercise, I am going to ask you to solve a basic conservation of \
energy problem:\nA ball of mass 20 g is dropped from a height of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["h", "TI"], TraditionalForm], "errors" -> {}, "input" -> "h", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e2b84b20-e50f-46c8-b9a4-fa67db348952"],
 " = 10 ft. After the ball hits the ground, it bounces to a max height of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox["1", "3"], 
         StyleBox["h", "TI"]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{1}{3}h", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "27d0254a-30dc-4f76-a989-036b642ca507"],
 " Calculate \n(a) The total energy (in Joules) of the ball before it is \
dropped\n(b) The speed of the ball (in m/s) as it hits the ground\n(c) The \
total energy of the ball after it hits the ground"
}], "Text",
 CellChangeTimes->{{3.9935529877369757`*^9, 3.9935532661775513`*^9}, {
  3.993553842636619*^9, 
  3.993553860256926*^9}},ExpressionUUID->"ebb60f1d-2601-4f44-a89c-\
8923c7b0c4d2"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"Your", " ", "code", " ", "here"}], "*)"}]], "Input",
 CellChangeTimes->{{3.9935529877369757`*^9, 
  3.993553269911674*^9}},ExpressionUUID->"cff27048-786b-42b6-93cf-\
05698c231d45"]
}, Closed]],

Cell[CellGroupData[{

Cell["Solution", "Subsubsection",
 CellChangeTimes->{{3.993553279552588*^9, 
  3.9935532871537*^9}},ExpressionUUID->"67c1bd86-7c35-4462-93c9-823713058245"],

Cell["\<\
For (a), we need only calculate the initial gravitational potential energy\
\>", "Text",
 CellChangeTimes->{{3.9935532946875877`*^9, 3.993553299563788*^9}, {
  3.993553489545657*^9, 
  3.9935535002241096`*^9}},ExpressionUUID->"4fc3fa07-be37-4c6c-9e60-\
d2b490180aa7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"Clear", " ", "constants"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"define", " ", "constants"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", " ", "=", " ", 
   TemplateBox[<|
    "query" -> "acceleration due to gravity", "boxes" -> TemplateBox[{
        InterpretationBox["\[InvisibleSpace]", 1], "\"g\"", 
        "standard accelerations due to gravity on the surface of the earth", 
        "\"StandardAccelerationOfGravity\""}, "Quantity", SyntaxForm -> Mod], 
     "allassumptions" -> {{
       "type" -> "Clash", "word" -> "acceleration due to gravity", "template" -> 
        "Assuming \"acceleration due to gravity\" is a unit${separator}Use as \
${desc} instead", "count" -> "2", "pulldown" -> "false", "default" -> 
        "{\"C\", \"acceleration due to gravity\"} -> {\"Unit\", \"dflt\"}", 
        "Values" -> {{
          "name" -> "Unit", "desc" -> "a unit", "input" -> 
           "{\"C\", \"acceleration due to gravity\"} -> {\"Unit\"}"}, {
          "name" -> "GeogravityWord", "desc" -> " referring to gravity", 
           "input" -> 
           "{\"C\", \"acceleration due to gravity\"} -> \
{\"GeogravityWord\"}"}}}, {
       "type" -> "Unit", "word" -> "acceleration due to gravity", "template" -> 
        "Assuming standard acceleration due to gravity for \"acceleration due \
to gravity\"${separator}Use ${desc} instead", "count" -> "2", "pulldown" -> 
        "false", "default" -> 
        "\"UnitClash\" -> {\"acceleration due to gravity\", \
{\"StandardAccelerationOfGravity\", \"dflt\"}}", 
        "Values" -> {{
          "name" -> "StandardAccelerationOfGravity", "desc" -> 
           "standard acceleration due to gravity", "input" -> 
           "\"UnitClash\" -> {\"acceleration due to gravity\", \
{\"StandardAccelerationOfGravity\"}}"}, {
          "name" -> "AccelerationOfFreeFall", "desc" -> 
           "acceleration of free fall (including centrifugal acceleration)", 
           "input" -> 
           "\"UnitClash\" -> {\"acceleration due to gravity\", \
{\"AccelerationOfFreeFall\"}}"}}}}, "assumptions" -> {}, "open" -> {1, 2}, 
     "querystate" -> {
      "Online" -> True, "Allowed" -> True, "mparse.jsp" -> 
       0.609257`6.236345521166293, "Messages" -> {}}, "contextinfo" -> 
     Automatic, "version" -> 5|>,
    "LinguisticAssistantTemplate"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"m", " ", "=", " ", 
   TemplateBox[{"20", "\"g\"", "grams", "\"Grams\""},
    "Quantity"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", " ", "=", " ", 
    TemplateBox[<|
     "query" -> "10 ft", "boxes" -> 
      TemplateBox[{"10", "\"ft\"", "feet", "\"Feet\""}, "Quantity", 
        SyntaxForm -> Mod], "allassumptions" -> {}, "assumptions" -> {}, 
      "open" -> {1, 2}, 
      "querystate" -> {
       "Online" -> True, "Allowed" -> True, "mparse.jsp" -> 
        0.367626`6.016951212361364, "Messages" -> {}}, "contextinfo" -> 
      Automatic, "version" -> 5|>,
     "LinguisticAssistantTemplate"]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"E0", " ", "=", 
  RowBox[{
   RowBox[{"UnitConvert", "[", " ", 
    RowBox[{
     RowBox[{"m", " ", "g", " ", "h"}], " ", ",", "\"\<Joules\>\""}], "]"}], "//",
    " ", "N", 
   RowBox[{"(*", 
    RowBox[{"initial", " ", "energy", " ", "in", " ", "Joules"}], 
    "*)"}]}]}]}], "Input",
 CellChangeTimes->{{3.993553279552588*^9, 3.993553292140222*^9}, {
  3.993553502893694*^9, 3.993553601214748*^9}},
 CellLabel->"In[36]:=",ExpressionUUID->"a797aa07-6f39-49c6-b73c-d7209cb15c9c"],

Cell["\<\
For  (b), we can simply use the formula for kinetic energy to find the speed\
\>", "Text",
 CellChangeTimes->{{3.993553626002872*^9, 3.9935536263946466`*^9}, {
  3.993553686859673*^9, 
  3.993553700255414*^9}},ExpressionUUID->"ffe91a9d-9a03-4a4c-9890-\
455c2ed1a326"],

Cell[BoxData[
 RowBox[{
  RowBox[{"v", "/.", " ", 
   RowBox[{"Solve", "[", 
    RowBox[{
     RowBox[{"E0", " ", "==", " ", 
      RowBox[{
       FractionBox["1", "2"], "m", " ", 
       SuperscriptBox["v", "2"]}]}], ",", "v"}], "]"}]}], "//", "UnitConvert",
   " ", 
  RowBox[{"(*", 
   RowBox[{
   "this", " ", "will", " ", "produce", " ", "both", " ", "the", " ", 
    "positive", " ", "and", " ", "negative", " ", "solution"}], 
   "*)"}]}]], "Input",
 CellChangeTimes->{{3.9935536085558367`*^9, 3.993553609630781*^9}, {
  3.993553706223*^9, 3.993553712875556*^9}, {3.9935538046367273`*^9, 
  3.9935538360247383`*^9}, {3.993553867940823*^9, 
  3.993553896733437*^9}},ExpressionUUID->"1d16a625-1475-42cb-b9ac-\
90cf4bbcc7b4"],

Cell["\<\
For (c), we simply do a similar calculation as we did for a, but with 1/3 the \
height\
\>", "Text",
 CellChangeTimes->{{3.993553899898736*^9, 
  3.9935539290474453`*^9}},ExpressionUUID->"42a90fff-91bf-44ff-b07a-\
1be651f4ebac"],

Cell[BoxData[
 RowBox[{"Ef", " ", "=", " ", 
  RowBox[{
   RowBox[{"UnitConvert", "[", " ", 
    RowBox[{
     RowBox[{"m", " ", "g", " ", 
      FractionBox["h", "4"]}], " ", ",", "\"\<Joules\>\""}], "]"}], "//", " ",
    "N", " ", 
   RowBox[{"(*", 
    RowBox[{"final", " ", "energy", " ", "in", " ", "Joules"}], 
    "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.993553899898736*^9, 3.993553959822122*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"e9a36512-5b44-427b-8017-7a5b9e332edb"]
}, Closed]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["III. Plotting and Graphics", "Section",
 CellChangeTimes->{{3.9762798208942547`*^9, 3.97627982922587*^9}, 
   3.9766254552397823`*^9, {3.992946176710211*^9, 3.9929461794550304`*^9}, {
   3.993553976999796*^9, 
   3.9935539833280897`*^9}},ExpressionUUID->"42863c33-dea1-3340-b8ff-\
13725f457a85"],

Cell["\<\
In this section we are going to go over some basic graphical features that \
Mathematica, including plots, primitive graphics, and animations. \
\>", "Text",
 CellChangeTimes->{
  3.976279839200224*^9, {3.993553988830265*^9, 3.993553995262281*^9}, {
   3.9935542256644497`*^9, 3.9935542624849033`*^9}, {3.99355572398722*^9, 
   3.993555730052067*^9}},ExpressionUUID->"57c8246b-1b5e-754e-bdfc-\
4680f07626ac"],

Cell[CellGroupData[{

Cell["1D Plots and Plot Options", "Subsection",
 CellChangeTimes->{
  3.976279839200224*^9, {3.993553988830265*^9, 3.993553995262281*^9}, {
   3.9935542256644497`*^9, 3.9935542624849033`*^9}, {3.99355572398722*^9, 
   3.993555748781045*^9}, {3.9935557845915947`*^9, 3.993555788307453*^9}, {
   3.99356257077696*^9, 
   3.9935625730925922`*^9}},ExpressionUUID->"568365a9-dac2-4afe-a5bd-\
5894478dbd3e"],

Cell[TextData[{
 "Perhaps one of the most useful features of Mathematica is its ability to \
produce plots and graphics suitable for presentations and publications. Let\
\[CloseCurlyQuote]s begin with simple 1D plots, these are made using the ",
 StyleBox["Plot ",
  FontWeight->"Bold"],
 "command. The basic syntax is ",
 StyleBox["Plot[",
  FontWeight->"Bold"],
 "<function>, {<variable>,<min>,<max>}",
 StyleBox["]. ",
  FontWeight->"Bold"],
 "The function can also be user-defined, you just need to make sure that the \
variable we are plotting against is the same as the function. Below is a plot \
of the function ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"cos", "(", 
         RowBox[{"\[Pi]", 
           StyleBox["x", "TI"]}], ")"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\cos(\\pi x)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "b450f433-f9f6-4839-8806-95013f9e4a4e"],
 " + sin(2 \[Pi] x)"
}], "Text",
 CellChangeTimes->{{3.993555801127294*^9, 3.9935558586240177`*^9}, {
  3.993555992841485*^9, 3.993556009821624*^9}, {3.993556043165888*^9, 
  3.993556217875204*^9}, {3.9935564066496677`*^9, 
  3.993556465846353*^9}},ExpressionUUID->"9ce0a53b-efe7-4f1c-b90a-\
471138db4112"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"Cos", "[", 
     RowBox[{"\[Pi]", " ", "x"}], "]"}], " ", "+", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"2", " ", "\[Pi]", " ", "x"}], "]"}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"user", " ", "defined", " ", "function"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"plot", " ", "of", " ", "function"}], "*)"}]}]}], "Input",
 CellChangeTimes->{
  3.976279839200224*^9, {3.993553988830265*^9, 3.993553995262281*^9}, {
   3.9935542256644497`*^9, 3.9935542624849033`*^9}, {3.99355572398722*^9, 
   3.9935557493770313`*^9}, {3.9935562353041553`*^9, 3.993556241907956*^9}, {
   3.9935562987489147`*^9, 3.993556307988772*^9}, {3.993556447846339*^9, 
   3.993556474250499*^9}, {3.993556822326075*^9, 3.993556836149935*^9}, {
   3.9935570535163116`*^9, 3.993557059000352*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"1e565ed4-8e93-45f2-9901-c65275d29e85"],

Cell[TextData[{
 "You can even plot multiple functions in the same ",
 StyleBox["Plot",
  FontWeight->"Bold"],
 " command:"
}], "Text",
 CellChangeTimes->{{3.993556840203178*^9, 3.993556854005563*^9}, {
  3.993556946807193*^9, 
  3.9935569545404663`*^9}},ExpressionUUID->"5e22706c-07af-4155-86b3-\
dd2ea8115261"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "x_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"Cos", "[", 
     RowBox[{"2", "\[Pi]", " ", "x"}], "]"}], " ", "+", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"\[Pi]", " ", "x"}], "]"}]}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"another", " ", "user", " ", "defined", " ", "function"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], ",", 
      RowBox[{"g", "[", "x", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"plot", " ", "both", " ", "of", " ", "the", " ", "user"}], "-", 
    RowBox[{"defined", " ", "functions", " ", "together"}]}], 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{3.993556840203178*^9, 3.993556854005563*^9}, {
  3.993556946807193*^9, 3.993557040779697*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"9261627e-582e-477c-bba8-c6f724907494"],

Cell[TextData[{
 "While it is nice that Mathematica changes the color of each function, in \
this particular case it is kind of difficult to tell which function is which \
without some careful thought. Fortunately, we can make use of plot options to \
label the different functions. To implement plot options, we have to include \
them after the domain specification, separate each option by a comma, and and \
use the arrow syntax as follows: \n",
 StyleBox["Plot[",
  FontWeight->"Bold"],
 "<function and domain info>, PlotOption1 -> <value1>, PlotOption2 -> \
<value2>, ...",
 StyleBox["]",
  FontWeight->"Bold"],
 ". \nAs an example, we will use the PlotLegends option on the previous plot."
}], "Text",
 CellChangeTimes->{{3.9935563172115993`*^9, 3.9935563208605137`*^9}, {
  3.993556355006337*^9, 3.993556390729535*^9}, {3.99355648461032*^9, 
  3.993556519554565*^9}, {3.9935565648952007`*^9, 3.993556805221444*^9}, {
  3.9935569908153*^9, 3.993556995691362*^9}, {3.9935570700554237`*^9, 
  3.9935571032403812`*^9}, {3.993557148613353*^9, 3.993557176313101*^9}, {
  3.993557207273381*^9, 3.99355723406155*^9}, {3.9935572648942127`*^9, 
  3.993557347172842*^9}, {3.99355740469923*^9, 3.99355740680333*^9}, {
  3.993557467752137*^9, 3.993557469847991*^9}, {3.993557549048712*^9, 
  3.993557576893153*^9}, {3.993557621289606*^9, 
  3.993557629393517*^9}},ExpressionUUID->"f887ab90-4aff-422d-b830-\
90588974af5f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], ",", 
      RowBox[{"g", "[", "x", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
    RowBox[{"PlotLegends", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<f(x)\>\"", ",", "\"\<g(x)\>\""}], "}"}]}]}], "]"}], 
  " "}]], "Input",
 CellChangeTimes->{{3.9935563172115993`*^9, 3.9935563208605137`*^9}, {
  3.993556355006337*^9, 3.993556390729535*^9}, {3.99355648461032*^9, 
  3.993556519554565*^9}, {3.9935565648952007`*^9, 3.993556805221444*^9}, {
  3.9935569908153*^9, 3.993556995691362*^9}, {3.9935570700554237`*^9, 
  3.9935571032403812`*^9}, {3.993557148613353*^9, 3.993557176313101*^9}, {
  3.993557207273381*^9, 3.99355723406155*^9}, {3.9935572648942127`*^9, 
  3.993557355772551*^9}, {3.9935574221241493`*^9, 3.993557512028625*^9}, {
  3.9935581954998283`*^9, 3.993558198387398*^9}, {3.993558257855788*^9, 
  3.993558271826297*^9}, {3.993558344684746*^9, 
  3.993558354620949*^9}},ExpressionUUID->"96b69643-5513-43fb-a34f-\
42c00dd172c3"],

Cell["\<\
Notice, if you are plotting multiple functions, you can adjust the plot \
option for each function by using a bracketed list { <function1 option val>, \
<function2 function val>, ...}. 
While this is great for trying to visualize plots for personal use, the above \
plot is hardly appropriate to put in a reports, publications, or \
presentations. \
\>", "Text",
 CellChangeTimes->{{3.9935563172115993`*^9, 3.9935563208605137`*^9}, {
  3.993556355006337*^9, 3.993556390729535*^9}, {3.99355648461032*^9, 
  3.993556519554565*^9}, {3.9935565648952007`*^9, 3.993556805221444*^9}, {
  3.9935569908153*^9, 3.993556995691362*^9}, {3.9935570700554237`*^9, 
  3.9935571032403812`*^9}, {3.993557148613353*^9, 3.993557176313101*^9}, {
  3.993557207273381*^9, 3.99355723406155*^9}, {3.9935572648942127`*^9, 
  3.993557346366622*^9}, {3.99355769774207*^9, 3.993557827639187*^9}, {
  3.993557922876432*^9, 3.993558025205161*^9}, {3.99355811790648*^9, 
  3.9935584250831833`*^9}, {3.993558496269965*^9, 3.9935585502784233`*^9}, {
  3.993559211765052*^9, 3.993559260109558*^9}, {3.9935595277959843`*^9, 
  3.993559539706023*^9}, {3.9935595901643467`*^9, 
  3.9935596265365467`*^9}},ExpressionUUID->"5ef4d05b-9636-4974-b7c7-\
db3f59be9337"],

Cell[CellGroupData[{

Cell["Plot Options for Formatting", "Subsubsection",
 CellChangeTimes->{{3.9935563172115993`*^9, 3.9935563208605137`*^9}, {
  3.993556355006337*^9, 3.993556390729535*^9}, {3.99355648461032*^9, 
  3.993556519554565*^9}, {3.9935565648952007`*^9, 3.993556805221444*^9}, {
  3.9935569908153*^9, 3.993556995691362*^9}, {3.9935570700554237`*^9, 
  3.9935571032403812`*^9}, {3.993557148613353*^9, 3.993557176313101*^9}, {
  3.993557207273381*^9, 3.99355723406155*^9}, {3.9935572648942127`*^9, 
  3.993557346366622*^9}, {3.99355769774207*^9, 3.993557827639187*^9}, {
  3.993557922876432*^9, 3.993558025205161*^9}, {3.99355811790648*^9, 
  3.9935584250831833`*^9}, {3.993558496269965*^9, 3.9935585502784233`*^9}, {
  3.993559211765052*^9, 3.993559260109558*^9}, {3.9935595277959843`*^9, 
  3.993559557572011*^9}},ExpressionUUID->"2a4fe017-0dd1-4a16-bbde-\
333db13bd47a"],

Cell[TextData[{
 "Here are a list of plot options that may be useful to tidy up plots, you \
will have to check the documentation to see what values are appropriate for \
each option.\n\t",
 StyleBox["PlotRange: ",
  FontWeight->"Bold"],
 "Allows you to change how much of the plot you can see within the plot \
window",
 "\n\t",
 StyleBox["PlotLabel: ",
  FontWeight->"Bold"],
 "Gives the plot an overall label\n\t",
 StyleBox["LabelStyle: ",
  FontWeight->"Bold"],
 "Allows you to edit the font of the label\n\t",
 StyleBox["PlotLabels: ",
  FontWeight->"Bold"],
 "Individually labels each function plotted\n\t",
 StyleBox["ColorFunction: ",
  FontWeight->"Bold"],
 "Changes the plot color based on the values of the function\n\t",
 StyleBox["AxesLabel: ",
  FontWeight->"Bold"],
 "Labels the axes\n\t",
 StyleBox["AxesStyle: ",
  FontWeight->"Bold"],
 "Allows you change the style of the axes\n\t",
 StyleBox["PlotStyle: ",
  FontWeight->"Bold"],
 "Allows you to edit the color, thickness, plot points, and style with which \
Mathematica plots the function\n\t",
 StyleBox["PlotLegends: ",
  FontWeight->"Bold"],
 "Creates a Legend for the plot\n\t",
 StyleBox["Background: ",
  FontWeight->"Bold"],
 "Allows you to change the color of the background\n\t",
 StyleBox["Ticks: ",
  FontWeight->"Bold"],
 "Allows you to change the plot ticks and scale along the axes\n\t",
 StyleBox["Frame: ",
  FontWeight->"Bold"],
 "Puts a frame around the plot\n\t",
 StyleBox["FrameLabel: ",
  FontWeight->"Bold"],
 "Allows you to label the frame\n\t",
 StyleBox["FrameTicks: ",
  FontWeight->"Bold"],
 "Allows you to change the Frame ticks\n\t",
 StyleBox["FrameStyle: ",
  FontWeight->"Bold"],
 "Allows you change the style of the frame\n\t",
 StyleBox["GridLines: ",
  FontWeight->"Bold"],
 "Allows you to put gridlines on your plots"
}], "Text",
 CellChangeTimes->{{3.9935563172115993`*^9, 3.9935563208605137`*^9}, {
  3.993556355006337*^9, 3.993556390729535*^9}, {3.99355648461032*^9, 
  3.993556519554565*^9}, {3.9935565648952007`*^9, 3.993556805221444*^9}, {
  3.9935569908153*^9, 3.993556995691362*^9}, {3.9935570700554237`*^9, 
  3.9935571032403812`*^9}, {3.993557148613353*^9, 3.993557176313101*^9}, {
  3.993557207273381*^9, 3.99355723406155*^9}, {3.9935572648942127`*^9, 
  3.993557346366622*^9}, {3.99355769774207*^9, 3.993557827639187*^9}, {
  3.993557922876432*^9, 3.993558025205161*^9}, {3.99355811790648*^9, 
  3.9935584250831833`*^9}, {3.993558496269965*^9, 3.9935585502784233`*^9}, {
  3.993559211765052*^9, 3.993559260109558*^9}, {3.9935595277959843`*^9, 
  3.993559528540181*^9}},ExpressionUUID->"2eeae750-3e9b-4682-a5b4-\
e6424cd39091"],

Cell["\<\
Below are some examples of what can be done with some of these plot options, \
feel free to mess around with the values or add your own to see how it works\
\>", "Text",
 CellChangeTimes->{{3.9935563172115993`*^9, 3.9935563208605137`*^9}, {
  3.993556355006337*^9, 3.993556390729535*^9}, {3.99355648461032*^9, 
  3.993556519554565*^9}, {3.9935565648952007`*^9, 3.993556805221444*^9}, {
  3.9935569908153*^9, 3.993556995691362*^9}, {3.9935570700554237`*^9, 
  3.9935571032403812`*^9}, {3.993557148613353*^9, 3.993557176313101*^9}, {
  3.993557207273381*^9, 3.99355723406155*^9}, {3.9935572648942127`*^9, 
  3.993557346366622*^9}, {3.99355769774207*^9, 3.993557827639187*^9}, {
  3.993557922876432*^9, 3.993558025205161*^9}, {3.99355811790648*^9, 
  3.993558445835081*^9}, {3.993558703507763*^9, 
  3.9935587193039427`*^9}},ExpressionUUID->"500f2590-9db3-4af3-9241-\
68ffd8cce53b"],

Cell[BoxData[{
 RowBox[{
  StyleBox[
   RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}],
   FontWeight->"Bold"], 
  StyleBox[" ",
   FontWeight->"Bold"], 
  StyleBox[
   RowBox[{
    StyleBox[
     RowBox[{"(", "*"}]], 
    RowBox[{"clear", " ", "all", " ", "variables"}], 
    StyleBox[
     RowBox[{"*", ")"}]]}],
   FontWeight->"Bold"], "\n", " ", 
  RowBox[{"(*", 
   RowBox[{"Some", " ", "user", " ", "defined", " ", "functions"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", "x", "]"}], 
    RowBox[{"Sin", "[", "x", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "x_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{"-", "x"}], "]"}], 
    RowBox[{"Cos", "[", "x", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "x_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"Sin", "[", "x", "]"}], 
    RowBox[{"Cos", "[", "x", "]"}]}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.9935563172115993`*^9, 3.9935563208605137`*^9}, {
  3.993556355006337*^9, 3.993556390729535*^9}, {3.99355648461032*^9, 
  3.993556519554565*^9}, {3.9935565648952007`*^9, 3.993556805221444*^9}, {
  3.9935569908153*^9, 3.993556995691362*^9}, {3.9935570700554237`*^9, 
  3.9935571032403812`*^9}, {3.993557148613353*^9, 3.993557176313101*^9}, {
  3.993557207273381*^9, 3.99355723406155*^9}, {3.9935572648942127`*^9, 
  3.993557346366622*^9}, {3.99355769774207*^9, 3.993557827639187*^9}, {
  3.993557922876432*^9, 3.993558025205161*^9}, {3.99355811790648*^9, 
  3.993558493529809*^9}, {3.993558553754777*^9, 3.993558591371956*^9}, {
  3.99355864938378*^9, 3.993558664143907*^9}},
 CellLabel->"In[54]:=",ExpressionUUID->"86982b36-f9c0-40d0-b861-a02c3b4c232d"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"g", "[", "x", "]"}], ",", 
     RowBox[{"h", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "Automatic"}], ",", 
   RowBox[{"Background", "->", "White"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<f(x)\>\"", ",", "\"\<g(x)\>\"", ",", "\"\<h(x)\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Red", ",", "Dashed"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", "Dotted"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Green", ",", "Thick"}], "}"}]}], "}"}]}], ",", " ", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
   RowBox[{"AxesStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Black", ",", " ", "Bold"}], "]"}]}], ",", " ", 
   RowBox[{"PlotLabel", "->", "\"\<Plot of some Functions\>\""}], ",", " ", 
   RowBox[{"LabelStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Bold", ",", " ", "Black"}], "]"}]}]}], "]"}]], "Input",
 CellChangeTimes->{{3.993558667915593*^9, 
  3.9935589299705067`*^9}},ExpressionUUID->"4a4ce593-112e-49df-a900-\
774f52ab053f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"g", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "\[Pi]"}], ",", "\[Pi]"}], "}"}], ",", 
    RowBox[{"PlotRange", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "8"}], ",", "5"}], "}"}]}], ",", 
    RowBox[{"Background", "->", "White"}], ",", 
    RowBox[{"AxesStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"Black", ",", " ", "Bold"}], "]"}]}], ",", " ", 
    RowBox[{"PlotLabel", "->", "\"\<Plot of a Function\>\""}], ",", " ", 
    RowBox[{"LabelStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"Bold", ",", " ", "Black"}], "]"}]}], ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"Black", ",", "Bold"}], "]"}]}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Independent Variable\>\"", ",", 
       " ", "\"\<Dependent Variable\>\""}], "}"}]}], ",", 
    RowBox[{"GridLines", "->", "Automatic"}], ",", 
    RowBox[{"ColorFunction", "->", " ", "\"\<TemperatureMap\>\""}]}], "]"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.99355898123486*^9, 3.9935590621519547`*^9}, {
  3.9935591440731077`*^9, 3.9935593407822933`*^9}, {3.993724648762589*^9, 
  3.993724653986656*^9}},ExpressionUUID->"0bf6f2e9-5b39-458d-ab6e-\
9c0cf47cea7c"],

Cell[TextData[{
 "Another thing to keep in mind is the scale of your plots, the command ",
 StyleBox["LogPlot, LogLinearPlot, ",
  FontWeight->"Bold"],
 "and",
 StyleBox[" LogLogPlot, ",
  FontWeight->"Bold"],
 "allow you to use a Logarithmic scale on one or both of the axes: "
}], "Text",
 CellChangeTimes->{{3.9937246028613987`*^9, 
  3.993724708185493*^9}},ExpressionUUID->"57950b82-06bd-42a1-b59a-\
2e2cbd275674"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LogPlot", "[", 
   RowBox[{
    RowBox[{"Exp", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "10"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Log", " ", "plot", " ", "scales", " ", "the", " ", "y"}], "-", 
     "axis"}], ",", " ", "logarithmically"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.9937246028613987`*^9, 3.993724713639654*^9}, {
  3.9937250047812033`*^9, 
  3.99372503377341*^9}},ExpressionUUID->"9a86e84f-87e9-4324-b835-\
baa3ea464f2d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LogLinearPlot", "[", 
   RowBox[{
    RowBox[{"Log", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", 
      SuperscriptBox["10", "4"]}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"LogLinearPlot", " ", "scales", " ", "the", " ", "x"}], "-", 
     "axis"}], ",", " ", "logarithmically"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.993725045317227*^9, 
  3.993725089849585*^9}},ExpressionUUID->"948c54eb-d75e-46df-bc0c-\
715d818bef52"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LogLogPlot", "[", 
   RowBox[{
    RowBox[{"x", "^", "x"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0.1", ",", "10"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"LogLogPlot", " ", "scales", " ", "both", " ", "axes"}], ",", " ",
     "logarithmically"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.993725095857695*^9, 3.9937251056708508`*^9}, {
  3.99372515483041*^9, 3.993725183078149*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"aced0550-3e5d-4d29-ab6b-90d0b674dd31"]
}, Closed]],

Cell[CellGroupData[{

Cell["Nuances of Plot Commands", "Subsubsection",
 CellChangeTimes->{{3.993559567912127*^9, 3.993559577068104*^9}, 
   3.993559632306389*^9, {3.993559792838234*^9, 
   3.993559810102415*^9}},ExpressionUUID->"fab1342d-2192-45e4-a4d9-\
e60bf0c9c465"],

Cell[TextData[{
 "The ",
 StyleBox["Plot ",
  FontWeight->"Bold"],
 "and other plotting commands use numerical calculations to make plots. \
Therefore, just like with other numerical commands, there are some options \
you can use to improve the accuracy and quality of your plots. The way that \
Mathematica plots is by sampling values in the domain specified and then uses \
recursive subdivisions to fill in the gaps between the sampling points. \
Typically, Mathematica does a good job of choosing the number of sampling \
points and recursive subdivisions automatically, but occasionally you may \
need to adjust these values for more complicated functions.  \n\nAs an \
example we are going to take a look at the truncated Fourier series for a \
Dirac delta function, here is code to initialize such a function:"
}], "Text",
 CellChangeTimes->{{3.9935596373408623`*^9, 3.9935597058095427`*^9}, {
   3.993559781982213*^9, 3.993559901187421*^9}, {3.993560704771345*^9, 
   3.993560715023013*^9}, {3.9935608562324963`*^9, 3.9935608567525387`*^9}, {
   3.9935609029649363`*^9, 3.9935609994140453`*^9}, {3.993561252224483*^9, 
   3.993561299981089*^9}, {3.993561392997718*^9, 3.993561426268659*^9}, 
   3.993561701812908*^9, {3.993562217342662*^9, 
   3.993562227413632*^9}},ExpressionUUID->"e0cf3238-782d-458d-9b43-\
f822e8fb6a90"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "\"\<`*\>\"", "]"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"f", "[", "x_", "]"}], "=", 
    RowBox[{"FourierSeries", "[", 
     RowBox[{
      RowBox[{"DiracDelta", "[", "x", "]"}], ",", "x", ",", "50"}], "]"}]}], 
   ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "generated", " ", "the", " ", "first", " ", "50", " ", "terms", " ", "of", 
    " ", "a", " ", "Fourier", " ", "series", " ", "for", " ", "a", " ", 
    "dirac", " ", "delta", " ", "function", " ", 
    RowBox[{"(", 
     RowBox[{
     "this", " ", "may", " ", "take", " ", "a", " ", "while", " ", "to", " ", 
      "execute"}], ")"}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.993559567912127*^9, 3.993559577068104*^9}, {
   3.993559632965892*^9, 3.9935596329664297`*^9}, {3.993559904099448*^9, 
   3.993559911723508*^9}, {3.993560151850478*^9, 3.993560163762302*^9}, {
   3.9935602057029552`*^9, 3.993560488050445*^9}, {3.993560525250621*^9, 
   3.9935605518976927`*^9}, {3.993560668491057*^9, 3.993560883357102*^9}, {
   3.993561005494339*^9, 3.993561070499343*^9}, {3.9935611115276127`*^9, 
   3.9935611959082193`*^9}, {3.9935612412406893`*^9, 3.9935612849412746`*^9}, 
   3.993561403263315*^9},ExpressionUUID->"bafca29a-7a70-4204-86c4-\
369951ef7224"],

Cell[TextData[{
 "This function is highly oscillatory, so if I tell Mathematica not to use \
any recursive subdivisions using ",
 StyleBox["MaxRecursion -> 0",
  FontWeight->"Bold"],
 ", we get a rather jagged plot:"
}], "Text",
 CellChangeTimes->{{3.9935614373183193`*^9, 3.9935614780906143`*^9}, {
   3.993561714728661*^9, 3.9935617247086906`*^9}, 
   3.9935622106940393`*^9},ExpressionUUID->"353f87dd-526a-421b-b292-\
b8575da878a3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", " ", 
    RowBox[{"MaxRecursion", "->", "0"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "a", " ", "plot", " ", "which", " ", "uses", " ", "zero", " ", "recursive",
     " ", "bisections"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.993559567912127*^9, 3.993559577068104*^9}, {
   3.993559632965892*^9, 3.9935596329664297`*^9}, {3.993559904099448*^9, 
   3.993559911723508*^9}, {3.993560151850478*^9, 3.993560163762302*^9}, {
   3.9935602057029552`*^9, 3.993560488050445*^9}, {3.993560525250621*^9, 
   3.9935605518976927`*^9}, {3.993560668491057*^9, 3.993560883357102*^9}, {
   3.993561005494339*^9, 3.993561070499343*^9}, {3.9935611115276127`*^9, 
   3.9935611959082193`*^9}, {3.9935612412406893`*^9, 3.9935612849412746`*^9}, 
   3.993561403263315*^9, {3.993561434106709*^9, 3.993561434286314*^9}},
 CellLabel->
  "In[257]:=",ExpressionUUID->"20774aaa-fc66-4244-b966-4ffe7e631321"],

Cell[TextData[{
 "However, I can remedy this by increasing the number of plotting points \
using ",
 StyleBox["PlotPoints",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{{3.993561484668564*^9, 3.993561510644498*^9}, {
  3.993561729541007*^9, 
  3.993561734777136*^9}},ExpressionUUID->"8d185b7e-922e-49f2-a374-\
1522abb8ed6e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
    RowBox[{"PlotRange", "->", "All"}], ",", 
    RowBox[{"PlotPoints", "->", "1000"}], ",", "  ", 
    RowBox[{"MaxRecursion", "->", "0"}]}], "]"}], " "}]], "Input",
 CellChangeTimes->{{3.993561484668564*^9, 3.9935615266916037`*^9}},
 CellLabel->
  "In[259]:=",ExpressionUUID->"3862ad49-d0c6-4d17-b815-3ab09018bf41"],

Cell["\<\
I can also alternatively have small amount of plotting points and increase \
the number of recursive subdivisions,\
\>", "Text",
 CellChangeTimes->{{3.993561557608705*^9, 3.993561570811241*^9}, {
  3.993561664852351*^9, 3.9935616861322107`*^9}, {3.993561746369462*^9, 
  3.99356176305886*^9}, {3.993562197421432*^9, 
  3.993562201533474*^9}},ExpressionUUID->"eea7be70-26b9-4acb-a816-\
e95f00902701"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotPoints", "->", "10"}], ",", " ", 
   RowBox[{"MaxRecursion", "->", "10"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.993561557608705*^9, 3.993561570811241*^9}, {
  3.993561664852351*^9, 3.9935616861322107`*^9}, {3.993561746369462*^9, 
  3.9935617745615463`*^9}, {3.993561866970715*^9, 3.993561915118944*^9}},
 CellLabel->
  "In[264]:=",ExpressionUUID->"9608dacf-af6b-4d5c-a254-6f333c384c8b"],

Cell["\<\
Feel free to mess around with the numbers to see how the plot changes. \
\>", "Text",
 CellChangeTimes->{{3.993562059685382*^9, 
  3.993562072883967*^9}},ExpressionUUID->"0e9da22d-6ffc-4c65-8a74-\
b28c83248c48"],

Cell[TextData[{
 "However, as stated before, Mathematica\[CloseCurlyQuote]s default is to \
automatically determine an appropriate amount for both ",
 StyleBox["PlotPoints ",
  FontWeight->"Bold"],
 "and ",
 StyleBox["MaxRecursions",
  FontWeight->"Bold"],
 ". So, you can usually omit having to mess with these options:"
}], "Text",
 CellChangeTimes->{{3.9935619188708467`*^9, 3.993562051503941*^9}, {
  3.993562084720646*^9, 
  3.99356208507231*^9}},ExpressionUUID->"6b75d403-a2ef-4743-a443-\
26bf327da2b1"],

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9935619188708467`*^9, 3.993562014771572*^9}},
 CellLabel->
  "In[265]:=",ExpressionUUID->"e2f56924-156c-4903-ad40-d2e9ccc9a969"],

Cell[TextData[{
 "In cases of complex numerical models, however, you may find that your plots \
are not turning out the way you would like. In these cases, consider changing \
some of these values. There are also options like ",
 StyleBox["Exclusions",
  FontWeight->"Bold"],
 " which works similar to the ",
 StyleBox["NIntegrate",
  FontWeight->"Bold"],
 " equivalent. You will likely have to look into the different options as you \
run into issues and learn with experience. \n",
 "\nAnother thing to note with plots is that they can handle quantities (i.e \
things with units), however, they will only plot the magnitudes without any \
units involved so be wary of what units your variables have. "
}], "Text",
 CellChangeTimes->{{3.9935620884655533`*^9, 3.9935621572367573`*^9}, {
  3.9935622367817717`*^9, 3.9935622500795717`*^9}, {3.9935622895782003`*^9, 
  3.993562304098381*^9}, {3.993562359766581*^9, 3.993562367666596*^9}, {
  3.993562525824066*^9, 3.993562549088335*^9}, {3.9935627603385963`*^9, 
  3.9935628276271887`*^9}},ExpressionUUID->"5f7cfd33-4c26-4151-a393-\
a99463237f4b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"a", " ", "=", " ", 
    TemplateBox[<|"query" -> "2 m/s^2", "boxes" -> TemplateBox[{"2", 
         RowBox[{"\"m\"", "\[InvisibleSpace]", "\"/\"", "\[InvisibleSpace]", 
           SuperscriptBox["\"s\"", "2"]}], "meters per second squared", 
         FractionBox["\"Meters\"", 
          SuperscriptBox["\"Seconds\"", "2"]]}, "Quantity", SyntaxForm -> 
        Mod], "allassumptions" -> {{
        "word" -> "", "template" -> 
         "Assuming \"m/s^2\" is a unit${separator}Use \"m\" as ${desc} \
instead", "count" -> "2", "pulldown" -> "false", "type" -> "MultiClash", 
         "default" -> "{\"MC\", \"m/s^2\"} -> {\"Unit\", \"dflt\"}", 
         "Values" -> {{
           "name" -> "Unit", "desc" -> "a unit", "input" -> 
            "{\"MC\", \"m/s^2\"} -> {\"Unit\"}", "word" -> "m/s^2"}, {
           "name" -> "Variable", "desc" -> "a variable", "input" -> 
            "{\"MC\", \"m/s^2\"} -> {\"Variable\"}", "word" -> "m"}}}}, 
      "assumptions" -> {}, "open" -> {1, 2}, 
      "querystate" -> {
       "Online" -> True, "Allowed" -> True, "mparse.jsp" -> 
        0.552398`6.1937970910084035, "Messages" -> {}}, "contextinfo" -> 
      Automatic, "version" -> 5|>,
     "LinguisticAssistantTemplate"]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"acceleration", " ", "of", " ", "2", " ", 
    RowBox[{"m", "/", 
     RowBox[{"s", "^", "2"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"F", "[", "x_", "]"}], ":=", " ", 
    RowBox[{
     RowBox[{"Quantity", "[", 
      RowBox[{"x", ",", "\"\<Kilograms\>\""}], "]"}], " ", "a"}]}], ";"}], 
  " ", 
  RowBox[{"(*", 
   RowBox[{
   "force", " ", "for", " ", "an", " ", "object", " ", "of", " ", "mass", " ",
     "x"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"F", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "0", ",", "10"}], "}"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "A", " ", "plot", " ", "which", " ", "is", " ", "gives", " ", "the", " ", 
     "force", " ", "in", " ", "Newtons", " ", "as", " ", "a", " ", "function",
      " ", "of", " ", "the", " ", "mass", " ", "in", " ", "kg"}], ",", " ", 
    RowBox[{
    "but", " ", "there", " ", "is", " ", "no", " ", "indication", " ", "as", " ",
      "to", " ", "what", " ", "the", " ", "units", " ", "are"}]}], 
   "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9935620884655533`*^9, 3.9935621572367573`*^9}, {
  3.9935622367817717`*^9, 3.993562340150737*^9}, {3.9935624291599693`*^9, 
  3.993562517052175*^9}},
 CellLabel->
  "In[293]:=",ExpressionUUID->"8d49791d-a9b5-446f-b82f-65def61659c1"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Plots in Higher Dimensions", "Subsection",
 CellChangeTimes->{{3.993562888231983*^9, 
  3.993562956946138*^9}},ExpressionUUID->"8b83c4cd-3fa5-4cad-b083-\
cd08f8a696c3"],

Cell["\<\
Mathematica also has a variety of options for displaying plots in higher \
dimensions. A lot of the plot options from before also apply to these plots, \
though you may have to look in the documentation to see how they work for \
each kind of plot. The rest of this section just highlights some useful plot \
commands with some examples. Keep in mind that it usually takes more \
computing power to render 3D graphics and you may be better off using a \
different representation.\
\>", "Text",
 CellChangeTimes->{{3.9937241419223633`*^9, 3.993724206578434*^9}, {
  3.993724244618885*^9, 3.9937243796358232`*^9}, {3.993724471900797*^9, 
  3.993724530377091*^9}, {3.993725313723442*^9, 3.993725326951376*^9}, {
  3.9937254938171453`*^9, 3.993725509268784*^9}, {3.993725650029883*^9, 
  3.99372565137537*^9}, {3.9937257526991377`*^9, 3.993725752778751*^9}, {
  3.993726110401692*^9, 3.9937261381262417`*^9}, {3.993726540753149*^9, 
  3.993726562777688*^9}, {3.993726682910562*^9, 3.993726701526477*^9}, {
  3.9937268138716288`*^9, 3.993726814351712*^9}, {3.9937310883147583`*^9, 
  3.993731118123075*^9}, {3.993732076722802*^9, 
  3.993732128515082*^9}},ExpressionUUID->"e79522e2-70e8-4a66-a027-\
e50aaddc11bd"],

Cell[CellGroupData[{

Cell["Plot3D", "Subsubsection",
 CellChangeTimes->{{3.993731166079125*^9, 
  3.99373117442467*^9}},ExpressionUUID->"2648272a-904c-407e-b3a8-\
f60c8ec4667f"],

Cell[TextData[{
 StyleBox["Plot3D",
  FontWeight->"Bold"],
 " allows you to visualize surfaces, note that with 3 D plots, you can use \
your mouse to click and drag to change the view of the plot . Commands like \
ViewPoint can also change at which view the plot is oriented to begin with . "
}], "Text",
 CellChangeTimes->{{3.99373119129797*^9, 
  3.993731193217367*^9}},ExpressionUUID->"ab9c67eb-7ea9-428b-9703-\
7ee94830b75b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"f", "[", 
   RowBox[{"x_", ",", "y_"}], "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"x", "^", "2"}], " ", 
   RowBox[{"Sin", "[", "y", "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Plot3D", "[", 
   RowBox[{
    RowBox[{"f", "[", 
     RowBox[{"x", ",", "y"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
    RowBox[{"ViewPoint", "->", " ", "Top"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{"A", " ", "plot", " ", "of", " ", 
    RowBox[{"x", "^", "2"}], " ", 
    RowBox[{"Sin", "[", "y", "]"}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.993731166079125*^9, 3.993731198891015*^9}, 
   3.9937312464209347`*^9},
 CellLabel->
  "In[256]:=",ExpressionUUID->"6956c78e-3dd0-4a50-9f9c-c123e41a0dd2"]
}, Closed]],

Cell[CellGroupData[{

Cell["Contour Plots", "Subsubsection",
 CellChangeTimes->{{3.993731127555088*^9, 
  3.9937311345347757`*^9}},ExpressionUUID->"631db1ae-d4d2-4a38-a567-\
70643096c58c"],

Cell[TextData[{
 StyleBox["ContourPlot",
  FontWeight->"Bold"],
 " is a great way to visualize a surface without using 3D graphics, adding a \
color function and a legend can help make it more readable. You can also use \
it to plot solution curves."
}], "Text",
 CellChangeTimes->{{3.9937265308103027`*^9, 3.993726549037188*^9}, {
  3.993726588197424*^9, 3.9937266799706*^9}, {3.993726828675848*^9, 
  3.993726832320002*^9}, {3.993726870344555*^9, 3.993726888904368*^9}, {
  3.993726927252527*^9, 3.9937269299002857`*^9}, {3.993727063161631*^9, 
  3.993727066041691*^9}, {3.993727376488308*^9, 
