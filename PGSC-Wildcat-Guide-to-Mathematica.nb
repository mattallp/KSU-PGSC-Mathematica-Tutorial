Cell[TextData[{
 "< less than, >greater than, >= greater than or equal to, <= less than or \
equal to. These are comparison operators between numbers, returns ",
 StyleBox["True",
  FontWeight->"Bold"],
 " if the comparison is true.  "
}], "Text",
 CellChangeTimes->{{3.9942461557946568`*^9, 3.994246203965748*^9}, {
  3.994246256089655*^9, 3.994246264862715*^9}, {3.9942468041281567`*^9, 
  3.9942468224472065`*^9}, {3.9942468639792976`*^9, 3.9942468806360035`*^9}, {
  3.9942469871346283`*^9, 
  3.994246988571413*^9}},ExpressionUUID->"bfff405a-c65b-764c-8a6a-\
7b43ec1ba6a3"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"1", " ", ">", "0"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Returns", " ", "true", " ", "becasue", " ", "1", " ", "is", " ", 
    "greater", " ", "than", " ", "0"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"1", ">=", " ", "3"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "returns", " ", "false", " ", "because", " ", "1", " ", "is", " ", "not", 
     " ", "greater", " ", "than", " ", "or", " ", "equal", " ", "to", " ", 
     "3"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"note", " ", "that", " ", "when", " ", "you", " ", "type"}], 
      " ", ">", " ", 
      RowBox[{"and", " ", "then"}]}], " ", "="}], ",", " ", 
    RowBox[{
     RowBox[{
     "it", " ", "will", " ", "automatically", " ", "turn", " ", "into"}], " ",
      ">="}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Clear", "[", 
  RowBox[{"a", ",", "b"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"a", ">", "b", " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Mathematica", " ", "simply", " ", "returns", " ", "the", " ", 
     "statement", " ", "a"}], ">", 
    RowBox[{
    "b", " ", "since", " ", "neither", " ", "are", " ", "defined", " ", "and",
      " ", "Mathematica", " ", "cannot", " ", "determine", " ", "a", " ", 
     "truth", " ", "value", " ", "for", " ", "the", " ", "statement"}]}], " ",
    "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9942460865725613`*^9, 3.994246126620245*^9}, {
  3.994246209518999*^9, 3.9942462871648693`*^9}, {3.9942506957381744`*^9, 
  3.9942507297899513`*^9}, {3.994251477277025*^9, 3.99425149062315*^9}, {
  3.994251620803074*^9, 3.9942516360179005`*^9}, {3.9942516925880775`*^9, 
  3.994251692859947*^9}},
 CellLabel->"In[51]:=",ExpressionUUID->"cabcb35f-c8f6-6a47-b8e3-98eed208970e"],

