74d45dddfaf0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ContourPlot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Cos", "[", "x", "]"}], 
     RowBox[{"Sin", "[", "y", "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", 
      RowBox[{
       RowBox[{"-", "2"}], "\[Pi]"}], ",", 
      RowBox[{"2", "\[Pi]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"y", ",", 
      RowBox[{
       RowBox[{"-", "2"}], "\[Pi]"}], ",", 
      RowBox[{"2", "\[Pi]"}]}], "}"}], ",", 
    RowBox[{"ColorFunction", "->", "\"\<DeepSeaColors\>\""}], ",", 
    RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"A", " ", "plot", " ", "of", " ", "the", " ", "surface", " ", "f", 
     RowBox[{"(", 
      RowBox[{"x", ",", "y"}], ")"}]}], " ", "=", " ", 
    RowBox[{
     RowBox[{"Cos", "[", "x", "]"}], 
     RowBox[{"Sin", "[", "y", "]"}]}]}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.9937265308103027`*^9, 3.993726549037188*^9}, {
  3.993726588197424*^9, 3.993726640787622*^9}, {3.993727117346572*^9, 
